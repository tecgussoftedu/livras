<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jspdf-autotable@3.8.2/dist/jspdf.plugin.autotable.min.js"></script>
<script>

/* ======================================================================
   CONFIGURAÇÃO DO FIREBASE
   Substitua os valores abaixo pelas credenciais do SEU projeto Firebase.
   Veja no chat como obter esses dados (Console do Firebase > Configurações
   do projeto > Seus apps > Config do SDK).
====================================================================== */
const firebaseConfig = {
  apiKey: "AIzaSyBAGfAER-FmY_tzdV79HXAq0rLEd1lU8Wc",
  authDomain: "gestaofrota-c00d6.firebaseapp.com",
  projectId: "gestaofrota-c00d6",
  storageBucket: "gestaofrota-c00d6.firebasestorage.app",
  messagingSenderId: "311703140769",
  appId: "1:311703140769:web:32b3635b9e241c982033e0"
};
/* ====================================================================== */

const statusEl = document.getElementById('connStatus');
const statusElLogin = document.getElementById('connStatusLogin');
const loginScreen = document.getElementById('loginScreen');
const setupEmpresaScreen = document.getElementById('setupEmpresaScreen');
const mainApp = document.getElementById('mainApp');
let db = null;
let auth = null;
let secondaryAuth = null;
let uid = null;
let colRef = null;
let entries = [];
let modoCriarConta = false;
let usuarioPendente = null; // guarda o "user" do Firebase Auth enquanto aguarda o cadastro da empresa

function setStatus(text, cls){
  statusEl.textContent = text;
  statusEl.className = 'status ' + cls;
  statusElLogin.textContent = text;
  statusElLogin.className = 'status ' + cls;
}

function mostrarTela(tela){
  loginScreen.classList.remove('show');
  setupEmpresaScreen.classList.remove('show');
  mainApp.classList.remove('show');
  tela.classList.add('show');
  document.body.classList.toggle('com-menu', tela === mainApp);
}

function fmtBRL(v){
  if(v === null || v === undefined || isNaN(v)) return "R$ --";
  return v.toLocaleString('pt-BR', {style:'currency', currency:'BRL'});
}
function fmtNum(v, dec){
  if(v === null || v === undefined || isNaN(v)) return "--";
  return v.toLocaleString('pt-BR', {minimumFractionDigits:dec, maximumFractionDigits:dec});
}
function fmtDate(ts){
  const d = ts && ts.toDate ? ts.toDate() : new Date();
  return d.toLocaleDateString('pt-BR', {day:'2-digit', month:'2-digit', year:'2-digit'});
}

// Garante que uma escrita só é considerada concluída se realmente confirmada pelo
// servidor dentro de um tempo curto — evita ficar "pendurado" numa fila offline
// silenciosa. Se não confirmar a tempo, o app trata como falha e avisa o usuário.
function salvarComConexaoObrigatoria(promiseFn, timeoutMs = 12000){
  if(!navigator.onLine){
    return Promise.reject(new Error('Sem conexão com a internet. Conecte-se e tente novamente.'));
  }
  const timeout = new Promise((_, reject) => {
    setTimeout(() => reject(new Error('Não foi possível confirmar o envio (conexão instável). Tente novamente.')), timeoutMs);
  });
  return Promise.race([promiseFn(), timeout]);
}

const offlineBanner = document.createElement('div');
offlineBanner.id = 'offlineBanner';
offlineBanner.textContent = '⚠ Sem conexão com a internet — não é possível registrar agora.';
offlineBanner.style.cssText = 'display:none;position:fixed;top:0;left:0;right:0;background:var(--bad);color:#fff;text-align:center;font-size:13px;font-weight:600;padding:8px;z-index:200;';
document.body.prepend(offlineBanner);

function atualizarEstadoConexao(){
  const online = navigator.onLine;
  offlineBanner.style.display = online ? 'none' : 'block';
  const btnAb = document.getElementById('btnSalvar');
  const btnMan = document.getElementById('btnSalvarManutencao');
  if(btnAb) btnAb.disabled = !online;
  if(btnMan) btnMan.disabled = !online;
}
window.addEventListener('online', atualizarEstadoConexao);
window.addEventListener('offline', atualizarEstadoConexao);

let empresaId = null;
let userRole = null;
let motoristaVeiculoId = null; // veículo padrão sugerido no convite — não trava mais o motorista a só esse veículo
let nomeUsuarioAtual = null;

// Retorna "existente" se já existe cadastro (e preenche empresaId/userRole).
// Retorna "convite" se achou um convite pendente e já vinculou o motorista.
// Retorna "novo" se este é o primeiro acesso e nenhuma empresa/convite foi encontrado.
async function resolverEmpresa(user){
  const usuarioRef = db.collection('usuarios').doc(user.uid);
  const usuarioSnap = await usuarioRef.get();

  if(usuarioSnap.exists){
    const dados = usuarioSnap.data();
    empresaId = dados.empresaId;
    userRole = dados.role;
    motoristaVeiculoId = dados.veiculoId || null;
    nomeUsuarioAtual = dados.nome || user.displayName || '';
    return 'existente';
  }

  if(!user.email) return 'novo';

  // Procura um convite pendente pra esse e-mail — busca DIRETA por documento
  // (não uma consulta ampla), pra nunca esbarrar na limitação do Firestore de
  // provar segurança em consultas cruzando várias empresas.
  const emailLower = user.email.toLowerCase();
  const conviteRef = db.collection('convites').doc(emailLower);
  const conviteSnap = await conviteRef.get();

  if(!conviteSnap.exists || conviteSnap.data().status !== 'pendente') return 'novo';

  const dadosConvite = conviteSnap.data();
  const empresaDoConvite = dadosConvite.empresaId;
  const papelConvite = dadosConvite.role === 'admin' ? 'admin' : 'motorista';
  const membroRef = db.collection('empresas').doc(empresaDoConvite).collection('membros').doc(emailLower);

  if(papelConvite === 'admin'){
    // Precisa reservar a vaga de admin de forma atômica, igual na criação direta —
    // senão o contador de admins do plano fica errado (ou até estoura o limite).
    const empresaRef = db.collection('empresas').doc(empresaDoConvite);
    try{
      await db.runTransaction(async (tx) => {
        tx.set(usuarioRef, {
          empresaId: empresaDoConvite,
          role: 'admin',
          nome: dadosConvite.nome || user.displayName || '',
          email: emailLower,
          criadoEm: firebase.firestore.FieldValue.serverTimestamp()
        });
        tx.update(empresaRef, { adminsCount: firebase.firestore.FieldValue.increment(1) });
        tx.update(conviteRef, { status: 'ativo', uid: user.uid });
        tx.update(membroRef, { status: 'ativo', uid: user.uid });
      });
    }catch(e){
      throw e;
    }
  } else {
    await conviteRef.update({ status: 'ativo', uid: user.uid });
    await membroRef.update({ status: 'ativo', uid: user.uid });
    await usuarioRef.set({
      empresaId: empresaDoConvite,
      role: 'motorista',
      nome: dadosConvite.nome || user.displayName || '',
      email: emailLower,
      veiculoId: dadosConvite.veiculoId || null,
      criadoEm: firebase.firestore.FieldValue.serverTimestamp()
    });
  }

  empresaId = empresaDoConvite;
  userRole = papelConvite;
  motoristaVeiculoId = dadosConvite.veiculoId || null;
  nomeUsuarioAtual = dadosConvite.nome || user.displayName || '';
  return 'convite';
}

let entriesQueryRef = null;

function removerConteudoDoOutroPapel(role){
  const outro = role === 'admin' ? 'motorista' : 'admin';
  document.querySelectorAll('.' + outro + '-only').forEach(el => el.remove());
  document.querySelectorAll('[data-role-only="' + outro + '"]').forEach(el => el.remove());
}

async function entrarNoApp(){
  mostrarTela(mainApp);
  removerConteudoDoOutroPapel(userRole);

  if(userRole === 'admin'){
    initVeiculos();
    initMotoristas();
    initDashboardFrota();
    initManutencoes();
    initAlertas();
    setStatus('sincronizado • admin • empresa ' + empresaId.slice(0,6), 'on');
    ativarTabPadrao('dashboard');
  } else {
    initVeiculos(); // motorista também precisa ler a lista de veículos pra escolher no formulário
    colRef = db.collection('empresas').doc(empresaId).collection('abastecimentos');
    entriesQueryRef = colRef.where('motoristaUid', '==', uid);
    listenEntries();
    initManutencoes();
    initAlertas();
    setStatus('sincronizado • motorista • ' + (nomeUsuarioAtual || ''), 'on');
    ativarTabPadrao('abastecimento');
  }
}

function ativarTabPadrao(tabKey){
  document.querySelectorAll('.tab-btn').forEach(x => x.classList.remove('active'));
  document.querySelectorAll('.tab-panel').forEach(x => x.classList.remove('active'));
  const btn = document.querySelector('.tab-btn[data-tab="' + tabKey + '"]');
  if(btn) btn.classList.add('active');
  document.getElementById(tabIds[tabKey]).classList.add('active');
}

let veiculosRef = null;
let veiculos = [];

let planoEmpresa = 'free';
const LIMITE_ILIMITADO = 1000000; // app gratuito e sem limites por enquanto
let limiteVeiculosEmpresa = LIMITE_ILIMITADO;
let limiteAdminsEmpresa = LIMITE_ILIMITADO;
let adminsCountEmpresa = 1;

function initVeiculos(){
  veiculosRef = db.collection('empresas').doc(empresaId).collection('veiculos');
  veiculosRef.orderBy('criadoEm', 'desc').onSnapshot(snap => {
    veiculos = [];
    snap.forEach(doc => veiculos.push({id: doc.id, ...doc.data()}));
    renderVeiculos();
  }, err => {
    document.getElementById('veiculosList').innerHTML = '<div class="empty">Erro ao carregar veículos: ' + err.message + '</div>';
  });

  // Escuta o próprio documento da empresa, pra manter plano/limite sempre atualizados
  // (útil quando, no futuro, um upgrade de plano mudar isso em tempo real).
  db.collection('empresas').doc(empresaId).onSnapshot(snap => {
    if(!snap.exists) return;
    const dados = snap.data();
    dadosEmpresaAtual = dados;
    planoEmpresa = dados.plano || 'free';
    limiteVeiculosEmpresa = LIMITE_ILIMITADO; // sem limites por enquanto (ignora o que estiver gravado)
    limiteAdminsEmpresa = LIMITE_ILIMITADO;
    adminsCountEmpresa = dados.adminsCount ?? 1;
    renderResumoEmpresa(dados);
  });
}

let dadosEmpresaAtual = null;

function renderResumoEmpresa(dados){
  const nomeEl = document.getElementById('empresaResumoNome');
  const detalheEl = document.getElementById('empresaResumoDetalhe');
  if(!nomeEl) return;
  nomeEl.textContent = dados.nome || '--';
  const partes = [];
  if(dados.cnpj) partes.push(dados.cnpj);
  if(dados.cidade && dados.estado) partes.push(dados.cidade + '/' + dados.estado);
  else if(dados.cidade) partes.push(dados.cidade);
  detalheEl.textContent = partes.length ? partes.join(' • ') : 'Sem CNPJ/endereço cadastrado';
}

function abrirEdicaoEmpresa(){
  if(!dadosEmpresaAtual) return;
  document.getElementById('editEmpNome').value = dadosEmpresaAtual.nome || '';
  document.getElementById('editEmpRazaoSocial').value = dadosEmpresaAtual.razaoSocial || '';
  document.getElementById('editEmpCnpj').value = dadosEmpresaAtual.cnpj || '';
  document.getElementById('editEmpTelefone').value = dadosEmpresaAtual.telefone || '';
  document.getElementById('editEmpEmailFinanceiro').value = dadosEmpresaAtual.emailFinanceiro || '';
  document.getElementById('editEmpEndereco').value = dadosEmpresaAtual.endereco || '';
  document.getElementById('editEmpCep').value = dadosEmpresaAtual.cep || '';
  document.getElementById('editEmpCidade').value = dadosEmpresaAtual.cidade || '';
  document.getElementById('editEmpEstado').value = dadosEmpresaAtual.estado || '';
  document.getElementById('editEmpMsg').textContent = '';
  document.getElementById('editEmpresaModal').classList.add('show');
}

document.getElementById('btnCancelarEdicaoEmpresa').addEventListener('click', () => {
  document.getElementById('editEmpresaModal').classList.remove('show');
});

document.getElementById('btnSalvarEdicaoEmpresa').addEventListener('click', async () => {
  const msg = document.getElementById('editEmpMsg');
  const nome = document.getElementById('editEmpNome').value.trim();
  const razaoSocial = document.getElementById('editEmpRazaoSocial').value.trim();
  const cnpj = document.getElementById('editEmpCnpj').value.trim();
  const telefone = document.getElementById('editEmpTelefone').value.trim();
  const emailFinanceiro = document.getElementById('editEmpEmailFinanceiro').value.trim();
  const endereco = document.getElementById('editEmpEndereco').value.trim();
  const cep = document.getElementById('editEmpCep').value.trim();
  const cidade = document.getElementById('editEmpCidade').value.trim();
  const estado = document.getElementById('editEmpEstado').value;

  if(!nome){
    msg.textContent = 'O nome fantasia não pode ficar em branco.';
    msg.className = 'msg err';
    return;
  }
  if(emailFinanceiro && !/^\S+@\S+\.\S+$/.test(emailFinanceiro)){
    msg.textContent = 'E-mail financeiro inválido.';
    msg.className = 'msg err';
    return;
  }

  const btn = document.getElementById('btnSalvarEdicaoEmpresa');
  btn.disabled = true;
  try{
    await db.collection('empresas').doc(empresaId).update({
      nome,
      razaoSocial: razaoSocial || null,
      cnpj: cnpj || null,
      telefone: telefone || null,
      emailFinanceiro: emailFinanceiro || null,
      endereco: endereco || null,
      cep: cep || null,
      cidade: cidade || null,
      estado: estado || null
    });
    document.getElementById('editEmpresaModal').classList.remove('show');
  }catch(e){
    msg.textContent = 'Erro ao salvar: ' + e.message;
    msg.className = 'msg err';
  }
  btn.disabled = false;
});

function renderChecklist(){
  const card = document.getElementById('cardChecklist');
  const list = document.getElementById('checklistList');
  if(!card || !list) return;

  const temVeiculo = veiculos.length > 0;
  const temMotorista = motoristas.some(m => m.uid && m.role === 'motorista');
  const temAbastecimento = frotaAbastecimentos.length > 0;

  if(temVeiculo && temMotorista && temAbastecimento){
    card.style.display = 'none';
    return;
  }
  card.style.display = 'block';

  const itens = [
    {feito: temVeiculo, titulo: 'Cadastre seu primeiro veículo', sub: 'Placa, modelo e km atual', tab: 'veiculos'},
    {feito: temMotorista, titulo: 'Crie o acesso de um motorista', sub: 'Nome, e-mail e senha prontos pra usar', tab: 'motoristas'},
    {feito: temAbastecimento, titulo: 'Registre o primeiro abastecimento', sub: 'Peça pro motorista lançar, ou lance você mesmo em "+ Novo" no Dashboard', tab: 'dashboard'}
  ];

  list.innerHTML = itens.map((it, i) => `
    <div class="checklist-item ${it.feito ? 'done' : ''}" onclick="document.querySelector('.tab-btn[data-tab=\\'${it.tab}\\']').click()">
      <div class="checklist-check">${it.feito ? '✓' : (i+1)}</div>
      <div class="checklist-text">
        <div class="titulo">${it.titulo}</div>
        <div class="sub">${it.sub}</div>
      </div>
    </div>
  `).join('');
}

function renderVeiculos(){
  const list = document.getElementById('veiculosList');
  if(!list){
    // Motorista não tem essa lista no DOM (removida por segurança) — só popula os selects abaixo.
  } else if(veiculos.length === 0){
    list.innerHTML = '<div class="empty">Nenhum veículo cadastrado ainda.</div>';
  } else {
    const tipos = {moto:'Moto', carro:'Carro', caminhonete:'Caminhonete', caminhao:'Caminhão', outro:'Outro'};
    list.innerHTML = veiculos.map(v => {
      const partesModelo = [v.marca, v.modelo].filter(Boolean).join(' ');
      const inativo = v.ativo === false;
      return `
      <div class="veiculo-item" style="${inativo ? 'opacity:0.5;' : ''}">
        <div>
          <div class="placa">${v.placa}${inativo ? ' <span class="status-badge pendente" style="margin-left:6px;">Inativo</span>' : ''}</div>
          <div class="modelo">${partesModelo ? partesModelo + ' • ' : ''}${tipos[v.tipo] || v.tipo}${v.ano ? ' • ' + v.ano : ''}</div>
        </div>
        <div style="display:flex;align-items:center;gap:8px;">
          <div class="km">${fmtNum(v.kmAtual,0)} km</div>
          <button class="icon-btn" onclick="abrirEdicaoVeiculo('${v.id}')" title="Editar">✎</button>
        </div>
      </div>
    `;
    }).join('');
  }

  const selectAb = document.getElementById('abVeiculo');
  if(selectAb){
    const atualAb = selectAb.value;
    const ativos = veiculos.filter(v => v.ativo !== false);
    selectAb.innerHTML = '<option value="">Selecione o veículo</option>' +
      ativos.map(v => `<option value="${v.id}">${v.placa}${v.modelo ? ' - ' + v.modelo : ''}</option>`).join('');
    selectAb.value = atualAb;
  }

  const selectMan = document.getElementById('manVeiculo');
  if(selectMan){
    const atualMan = selectMan.value;
    const ativosMan = veiculos.filter(v => v.ativo !== false);
    selectMan.innerHTML = '<option value="">Selecione o veículo</option>' +
      ativosMan.map(v => `<option value="${v.id}">${v.placa}${v.modelo ? ' - ' + v.modelo : ''}</option>`).join('');
    selectMan.value = atualMan;
  }

  const selectAl = document.getElementById('alVeiculo');
  if(selectAl){
    const atualAl = selectAl.value;
    const ativosAl = veiculos.filter(v => v.ativo !== false);
    selectAl.innerHTML = '<option value="">Selecione o veículo</option>' +
      ativosAl.map(v => `<option value="${v.id}">${v.placa}${v.modelo ? ' - ' + v.modelo : ''}</option>`).join('');
    selectAl.value = atualAl;
  }

  const selectRel = document.getElementById('relVeiculo');
  if(selectRel){
    const atualRel = selectRel.value;
    selectRel.innerHTML = '<option value="">Todos</option>' +
      veiculos.map(v => `<option value="${v.id}">${v.placa}${v.modelo ? ' - ' + v.modelo : ''}</option>`).join('');
    selectRel.value = atualRel;
  }

  if(document.getElementById('rankingVeiculos') && typeof renderDashboardFrota === 'function' && frotaAbastecimentos){
    renderDashboardFrota();
  }
  renderChecklist();
}

document.getElementById('btnAddVeiculo').addEventListener('click', async () => {
  const msg = document.getElementById('veiculoMsg');
  const placa = document.getElementById('vecPlaca').value.trim().toUpperCase();
  const marca = document.getElementById('vecMarca').value.trim();
  const modelo = document.getElementById('vecModelo').value.trim();
  const tipo = document.getElementById('vecTipo').value;
  const ano = parseInt(document.getElementById('vecAno').value) || null;
  const kmInicial = parseFloat(document.getElementById('vecKmInicial').value) || 0;

  msg.textContent = '';
  msg.className = 'msg';

  if(!placa){
    msg.textContent = 'Informe a placa do veículo.';
    msg.className = 'msg err';
    return;
  }
  if(!veiculosRef){
    msg.textContent = 'Aguarde a sincronização com a empresa.';
    msg.className = 'msg err';
    return;
  }

  const btn = document.getElementById('btnAddVeiculo');
  btn.disabled = true;
  try{
    const empresaRef = db.collection('empresas').doc(empresaId);
    const novoVeiculoRef = veiculosRef.doc();

    await db.runTransaction(async (tx) => {
      const empresaSnap = await tx.get(empresaRef);
      await tx.get(empresaRef);

      tx.set(novoVeiculoRef, {
        placa,
        marca: marca || null,
        modelo: modelo || null,
        tipo,
        ano,
        kmAtual: kmInicial,
        ativo: true,
        criadoEm: firebase.firestore.FieldValue.serverTimestamp()
      });
      tx.update(empresaRef, {
        veiculosCount: firebase.firestore.FieldValue.increment(1)
      });
    });

    document.getElementById('vecPlaca').value = '';
    document.getElementById('vecMarca').value = '';
    document.getElementById('vecModelo').value = '';
    document.getElementById('vecAno').value = '';
    document.getElementById('vecKmInicial').value = '';
    msg.textContent = 'Veículo adicionado.';
    msg.className = 'msg ok';
  }catch(e){
    msg.textContent = 'Erro ao salvar: ' + e.message;
    msg.className = 'msg err';
  }
  btn.disabled = false;
});

let tipoVeiculoStatus = 'ativo';
document.querySelectorAll('#grpVecStatus .toggle-btn').forEach(b => {
  b.addEventListener('click', () => {
    document.querySelectorAll('#grpVecStatus .toggle-btn').forEach(x => x.classList.remove('active'));
    b.classList.add('active');
    tipoVeiculoStatus = b.dataset.value;
  });
});

function abrirEdicaoVeiculo(id){
  const v = veiculos.find(x => x.id === id);
  if(!v) return;

  document.getElementById('editVecPlaca').value = v.placa || '';
  document.getElementById('editVecMarca').value = v.marca || '';
  document.getElementById('editVecModelo').value = v.modelo || '';
  document.getElementById('editVecTipo').value = v.tipo || 'moto';
  document.getElementById('editVecAno').value = v.ano || '';
  document.getElementById('editVecKm').value = v.kmAtual || 0;

  tipoVeiculoStatus = v.ativo === false ? 'inativo' : 'ativo';
  document.querySelectorAll('#grpVecStatus .toggle-btn').forEach(x => x.classList.toggle('active', x.dataset.value === tipoVeiculoStatus));

  document.getElementById('editVecMsg').textContent = '';
  document.getElementById('editVeiculoModal').dataset.editId = id;
  document.getElementById('editVeiculoModal').classList.add('show');
}

document.getElementById('btnCancelarEdicaoVeiculo').addEventListener('click', () => {
  document.getElementById('editVeiculoModal').classList.remove('show');
});

document.getElementById('btnSalvarEdicaoVeiculo').addEventListener('click', async () => {
  const id = document.getElementById('editVeiculoModal').dataset.editId;
  const msg = document.getElementById('editVecMsg');
  const placa = document.getElementById('editVecPlaca').value.trim().toUpperCase();
  const marca = document.getElementById('editVecMarca').value.trim();
  const modelo = document.getElementById('editVecModelo').value.trim();
  const tipo = document.getElementById('editVecTipo').value;
  const ano = parseInt(document.getElementById('editVecAno').value) || null;
  const km = parseFloat(document.getElementById('editVecKm').value) || 0;

  if(!placa){
    msg.textContent = 'A placa não pode ficar em branco.';
    msg.className = 'msg err';
    return;
  }

  const btn = document.getElementById('btnSalvarEdicaoVeiculo');
  btn.disabled = true;
  try{
    await db.collection('empresas').doc(empresaId).collection('veiculos').doc(id).update({
      placa, marca: marca || null, modelo: modelo || null, tipo, ano,
      kmAtual: km,
      ativo: tipoVeiculoStatus === 'ativo'
    });
    document.getElementById('editVeiculoModal').classList.remove('show');
  }catch(e){
    msg.textContent = 'Erro ao salvar: ' + e.message;
    msg.className = 'msg err';
  }
  btn.disabled = false;
});

document.getElementById('btnExcluirVeiculo').addEventListener('click', async () => {
  const id = document.getElementById('editVeiculoModal').dataset.editId;
  if(!confirm('Excluir este veículo? Abastecimentos e manutenções já registrados continuam no histórico, mas ficam sem veículo vinculado.')) return;
  try{
    await db.collection('empresas').doc(empresaId).collection('veiculos').doc(id).delete();
    db.collection('empresas').doc(empresaId).update({
      veiculosCount: firebase.firestore.FieldValue.increment(-1)
    }).catch(() => {});
    document.getElementById('editVeiculoModal').classList.remove('show');
  }catch(e){
    alert('Erro ao excluir: ' + e.message);
  }
});

let membrosRef = null;
let motoristas = [];

function initMotoristas(){
  membrosRef = db.collection('empresas').doc(empresaId).collection('membros');
  membrosRef.orderBy('convidadoEm', 'desc').onSnapshot(snap => {
    motoristas = [];
    snap.forEach(doc => motoristas.push({id: doc.id, ...doc.data()}));
    renderMotoristas();
  }, err => {
    document.getElementById('motoristasList').innerHTML = '<div class="empty">Erro ao carregar equipe: ' + err.message + '</div>';
  });
}

function renderMotoristas(){
  const list = document.getElementById('motoristasList');

  const selectRelMot = document.getElementById('relMotorista');
  if(selectRelMot){
    const atualRelMot = selectRelMot.value;
    const ativos = motoristas.filter(m => m.uid);
    selectRelMot.innerHTML = '<option value="">Todos</option>' +
      ativos.map(m => `<option value="${m.uid}">${m.nome}</option>`).join('');
    selectRelMot.value = atualRelMot;
  }

  if(motoristas.length === 0){
    list.innerHTML = '<div class="empty">Ninguém cadastrado ainda.</div>';
  } else {
    list.innerHTML = motoristas.map(m => {
      const veiculo = veiculos.find(v => v.id === m.veiculoId);
      const ehAdmin = m.role === 'admin';
      const ehVoceMesmo = m.uid === uid;
      return `<div class="motorista-item" style="flex-direction:column;align-items:stretch;">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;">
          <div>
            <div class="nome">${m.nome}${ehVoceMesmo ? ' (você)' : ''}</div>
            <div class="email">${m.email}</div>
            ${veiculo ? `<div class="veiculo-vinc">${veiculo.placa}${veiculo.modelo ? ' - ' + veiculo.modelo : ''}</div>` : ''}
          </div>
          <span class="status-badge ${m.status === 'ativo' ? 'ativo' : 'pendente'}" style="${ehAdmin && m.status === 'ativo' ? 'background:rgba(255,122,26,0.18);color:var(--amber);' : ''}">${ehAdmin && m.status === 'ativo' ? 'Admin' : (m.status === 'ativo' ? 'Ativo' : (ehAdmin ? 'Admin pendente' : 'Pendente'))}</span>
        </div>
        <div style="display:flex;gap:6px;margin-top:8px;flex-wrap:wrap;">
          <button class="icon-btn" onclick="abrirEdicaoMembro('${m.id}')" title="Editar membro">✎ Editar</button>
          ${m.uid ? `<button class="icon-btn" onclick="redefinirSenhaMembro('${m.email}')" title="Enviar redefinição de senha">🔑 Senha</button>` : ''}
          ${m.status !== 'ativo' ? `<button class="icon-btn" onclick="copiarConvite('${m.nome.replace(/'/g,"\\'")}','${m.email}')" title="Copiar convite">⧉ Convite</button>` : ''}
          ${!ehVoceMesmo ? `<button class="icon-btn danger" onclick="removerMotorista('${m.id}')" title="Remover">✕ Remover</button>` : ''}
        </div>
      </div>`;
    }).join('');
  }
  renderChecklist();
}

function copiarConvite(nome, email, senha){
  const url = window.location.origin + window.location.pathname;
  const texto = senha
    ? `Olá ${nome}! Seu acesso ao FrotaGo já está pronto.\n\nAcesse aqui: ${url}\nE-mail: ${email}\nSenha: ${senha}\n\nÉ só entrar, não precisa cadastrar nada.`
    : `Olá ${nome}! Você foi vinculado(a) à nossa empresa no FrotaGo.\n\nComo você já tem uma conta no sistema (de outro vínculo anterior), é só entrar com o e-mail e a senha que você já usa: ${url}\nE-mail: ${email}\n\nSe não lembrar a senha, use "Esqueci minha senha" na tela de login. Assim que entrar, seu acesso cai automaticamente na nossa empresa.`;

  if(navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(texto).then(() => {
      alert('Acesso copiado! Agora é só colar no WhatsApp, SMS ou e-mail.');
    }).catch(() => {
      prompt('Copie o texto abaixo:', texto);
    });
  } else {
    prompt('Copie o texto abaixo:', texto);
  }
}

function abrirEdicaoMembro(id){
  const m = motoristas.find(x => x.id === id);
  if(!m) return;
  document.getElementById('editMembroNome').value = m.nome || '';
  document.getElementById('editMembroEmail').value = m.email || '';
  document.getElementById('editMembroMsg').textContent = '';
  const papelAtual = m.role === 'admin' ? 'admin' : 'motorista';
  papelEdicaoMembro = papelAtual;
  document.querySelectorAll('#grpEditPapelMembro .toggle-btn').forEach(x => x.classList.toggle('active', x.dataset.value === papelAtual));
  // Não deixa o admin mudar o próprio papel (evita ficar sem administrador)
  document.getElementById('campoEditPapelMembro').style.display = (m.uid && m.uid === uid) ? 'none' : 'block';
  document.getElementById('editMembroModal').dataset.editId = id;
  document.getElementById('editMembroModal').dataset.editUid = m.uid || '';
  document.getElementById('editMembroModal').dataset.editRole = papelAtual;
  document.getElementById('editMembroModal').classList.add('show');
}

let papelEdicaoMembro = 'motorista';
document.querySelectorAll('#grpEditPapelMembro .toggle-btn').forEach(b => {
  b.addEventListener('click', () => {
    document.querySelectorAll('#grpEditPapelMembro .toggle-btn').forEach(x => x.classList.remove('active'));
    b.classList.add('active');
    papelEdicaoMembro = b.dataset.value;
  });
});

document.getElementById('btnCancelarEdicaoMembro').addEventListener('click', () => {
  document.getElementById('editMembroModal').classList.remove('show');
});

document.getElementById('btnSalvarEdicaoMembro').addEventListener('click', async () => {
  const modal = document.getElementById('editMembroModal');
  const id = modal.dataset.editId;
  const membroUid = modal.dataset.editUid;
  const msg = document.getElementById('editMembroMsg');
  const novoNome = document.getElementById('editMembroNome').value.trim();

  if(!novoNome){
    msg.textContent = 'O nome não pode ficar em branco.';
    msg.className = 'msg err';
    return;
  }

  const papelOriginal = modal.dataset.editRole || 'motorista';
  const mudouPapel = papelEdicaoMembro !== papelOriginal && membroUid !== uid;

  const btn = document.getElementById('btnSalvarEdicaoMembro');
  btn.disabled = true;
  try{
    if(!mudouPapel){
      await membrosRef.doc(id).update({ nome: novoNome });
      if(membroUid){
        await db.collection('usuarios').doc(membroUid).update({ nome: novoNome }).catch(() => {});
      }
    } else if(!membroUid){
      // Convite ainda pendente: só ajusta o papel no convite e no membro.
      // (O limite de admins é checado quando a pessoa ativar o acesso.)
      await membrosRef.doc(id).update({ nome: novoNome, role: papelEdicaoMembro });
      await db.collection('convites').doc(id).update({ nome: novoNome, role: papelEdicaoMembro }).catch(() => {});
    } else {
      // Membro ativo: troca de papel + contador de admins de forma atômica.
      const empresaRef = db.collection('empresas').doc(empresaId);
      const usuarioRef = db.collection('usuarios').doc(membroUid);
      const membroRef = membrosRef.doc(id);
      const novoPapel = papelEdicaoMembro;
      await db.runTransaction(async (tx) => {
        const empresaSnap = await tx.get(empresaRef);
        const d = empresaSnap.data() || {};
        const cont = d.adminsCount ?? 1;
        if(novoPapel === 'admin'){
          tx.update(empresaRef, { adminsCount: firebase.firestore.FieldValue.increment(1) });
        } else {
          if(cont <= 1) throw new Error('ULTIMO_ADMIN');
          tx.update(empresaRef, { adminsCount: firebase.firestore.FieldValue.increment(-1) });
        }
        tx.update(usuarioRef, { role: novoPapel, nome: novoNome });
        tx.update(membroRef, { role: novoPapel, nome: novoNome });
      });
    }
    modal.classList.remove('show');
  }catch(e){
    if(e.message === 'ULTIMO_ADMIN'){
      msg.textContent = 'Não é possível rebaixar o último administrador da empresa.';
    } else {
      msg.textContent = 'Erro ao salvar: ' + e.message;
    }
    msg.className = 'msg err';
  }
  btn.disabled = false;
});

async function redefinirSenhaMembro(email){
  if(!confirm('Enviar e-mail de redefinição de senha para ' + email + '?')) return;
  try{
    await auth.sendPasswordResetEmail(email);
    alert('E-mail de redefinição enviado para ' + email + '.');
  }catch(e){
    alert('Erro ao enviar: ' + e.message);
  }
}

async function removerMotorista(id){
  if(!membrosRef) return;
  const doc = await membrosRef.doc(id).get();
  const dados = doc.data();
  if(!dados) return;

  const ehAdmin = dados.role === 'admin';
  if(ehAdmin && adminsCountEmpresa <= 1){
    alert('Não é possível remover o último administrador da empresa.');
    return;
  }

  const tipoTexto = ehAdmin ? 'este administrador' : 'este motorista';
  if(!confirm('Remover ' + tipoTexto + '? A pessoa perde o acesso à empresa imediatamente (a conta de login continua existindo, mas sem nenhum dado vinculado).')) return;

  try{
    if(dados.uid){
      await db.collection('usuarios').doc(dados.uid).delete().catch(() => {});
    }
    await membrosRef.doc(id).delete();
    db.collection('convites').doc(id).delete().catch(() => {}); // limpa convite pendente, se houver
    if(ehAdmin){
      db.collection('empresas').doc(empresaId).update({
        adminsCount: firebase.firestore.FieldValue.increment(-1)
      }).catch(() => {});
    }
  }catch(e){
    alert('Erro ao remover: ' + e.message);
  }
}

let frotaAbastecimentos = [];

function initDashboardFrota(){
  db.collection('empresas').doc(empresaId).collection('abastecimentos').onSnapshot(snap => {
    frotaAbastecimentos = [];
    snap.forEach(doc => frotaAbastecimentos.push({id: doc.id, ...doc.data()}));
    renderDashboardFrota();
  }, err => {
    document.getElementById('rankingVeiculos').innerHTML = '<div class="empty">Erro ao carregar dados: ' + err.message + '</div>';
  });
}

function renderDashboardFrota(){
  if(!document.getElementById('rankingVeiculos')) return; // painel de admin não existe no DOM do motorista

  // Agrupa os registros por veículo e calcula km rodado / consumo de cada um,
  // do mesmo jeito que já fazemos pro motorista individual — só que por veículo.
  const porVeiculo = {};
  frotaAbastecimentos.forEach(r => {
    if(!r.veiculoId) return;
    if(!porVeiculo[r.veiculoId]) porVeiculo[r.veiculoId] = [];
    porVeiculo[r.veiculoId].push(r);
  });

  let gastoTotalFrota = 0;
  let litrosTotalFrota = 0;
  let kmTotalFrota = 0;
  const ranking = [];

  Object.keys(porVeiculo).forEach(veiculoId => {
    const registros = porVeiculo[veiculoId].slice().sort((a,b) => a.kmAtual - b.kmAtual);
    const gastoVeiculo = registros.reduce((s,r) => s + (r.valorReais||0), 0);
    const litrosVeiculo = registros.reduce((s,r) => s + (r.litros||0), 0);
    let kmRodadoVeiculo = 0;
    let litrosComDelta = 0;
    for(let i = 1; i < registros.length; i++){
      kmRodadoVeiculo += registros[i].kmAtual - registros[i-1].kmAtual;
      litrosComDelta += registros[i].litros;
    }
    const consumoMedio = litrosComDelta > 0 ? kmRodadoVeiculo / litrosComDelta : null;

    gastoTotalFrota += gastoVeiculo;
    litrosTotalFrota += litrosVeiculo;
    kmTotalFrota += kmRodadoVeiculo;

    const veiculo = veiculos.find(v => v.id === veiculoId);
    ranking.push({
      veiculoId,
      placa: veiculo ? veiculo.placa : 'Veículo removido',
      modelo: veiculo ? veiculo.modelo : '',
      consumoMedio,
      gastoVeiculo,
      kmRodadoVeiculo,
      qtdRegistros: registros.length
    });
  });

  document.getElementById('fdGastoTotal').textContent = fmtBRL(gastoTotalFrota);
  document.getElementById('fdCustoKm').textContent = kmTotalFrota > 0 ? fmtBRL(gastoTotalFrota/kmTotalFrota) : 'R$ --';
  document.getElementById('fdKmTotal').textContent = kmTotalFrota > 0 ? fmtNum(kmTotalFrota,0) + ' km' : '--';
  document.getElementById('fdLitrosTotal').textContent = fmtNum(litrosTotalFrota,1) + ' L';

  const rankEl = document.getElementById('rankingVeiculos');
  if(ranking.length === 0){
    rankEl.innerHTML = '<div class="empty">Nenhum abastecimento registrado na frota ainda.</div>';
  } else {
    ranking.sort((a,b) => {
      if(a.consumoMedio === null) return 1;
      if(b.consumoMedio === null) return -1;
      return b.consumoMedio - a.consumoMedio;
    });
    rankEl.innerHTML = ranking.map((v,i) => `
      <div class="ranking-item">
        <div class="ranking-pos">${i+1}º</div>
        <div style="flex:1;">
          <div class="placa">${v.placa}</div>
          <div class="modelo">${v.modelo || ''}${v.modelo ? ' • ' : ''}${v.qtdRegistros} abastecimento${v.qtdRegistros !== 1 ? 's' : ''}</div>
        </div>
        <div class="ranking-right">
          <div class="consumo">${v.consumoMedio !== null ? fmtNum(v.consumoMedio,1) + ' km/l' : '--'}</div>
          <div class="gasto">${fmtBRL(v.gastoVeiculo)}</div>
        </div>
      </div>
    `).join('');
  }

  renderGraficos(ranking);
  renderListaFrotaAbastecimentos();
  renderChecklist();
}

const tiposLabelGlobal = {gasolina_comum:'Gasolina Comum', gasolina_aditivada:'Gasolina Aditivada', etanol:'Etanol', diesel_s10:'Diesel S10', diesel_comum:'Diesel Comum', gnv:'GNV'};

let chartsInstancias = {};

function criarOuAtualizarChart(canvasId, config){
  const canvas = document.getElementById(canvasId);
  if(!canvas) return;
  if(chartsInstancias[canvasId]){
    chartsInstancias[canvasId].destroy();
  }
  chartsInstancias[canvasId] = new Chart(canvas.getContext('2d'), config);
}

const chartCoresGrid = 'rgba(139,146,155,0.15)';
const chartCoresTexto = '#8b929b';

function renderGraficos(ranking){
  if(typeof Chart === 'undefined') return;
  if(!document.getElementById('chartGastosMes')) return;

  // Agrupa por mês (AAAA-MM) os registros com data válida.
  const comData = frotaAbastecimentos.filter(r => r.data && r.data.toDate);
  const porMes = {};
  comData.forEach(r => {
    const d = r.data.toDate();
    const chave = d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0');
    if(!porMes[chave]) porMes[chave] = {gasto: 0, litros: 0, somaPreco: 0, qtdPreco: 0};
    porMes[chave].gasto += (r.valorReais || 0);
    porMes[chave].litros += (r.litros || 0);
    if(r.litros > 0 && r.valorReais > 0){
      porMes[chave].somaPreco += (r.valorReais / r.litros);
      porMes[chave].qtdPreco += 1;
    }
  });

  const mesesOrdenados = Object.keys(porMes).sort().slice(-6); // últimos 6 meses com dados
  const labelsMes = mesesOrdenados.map(m => {
    const [ano, mes] = m.split('-');
    return ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'][parseInt(mes)-1] + '/' + ano.slice(2);
  });

  criarOuAtualizarChart('chartGastosMes', {
    type: 'bar',
    data: {
      labels: labelsMes.length ? labelsMes : ['Sem dados'],
      datasets: [{
        label: 'Gasto (R$)',
        data: mesesOrdenados.length ? mesesOrdenados.map(m => porMes[m].gasto.toFixed(2)) : [0],
        backgroundColor: 'rgba(255,122,26,0.7)',
        borderRadius: 4
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { grid: { display: false }, ticks: { color: chartCoresTexto } },
        y: { grid: { color: chartCoresGrid }, ticks: { color: chartCoresTexto } }
      }
    }
  });

  criarOuAtualizarChart('chartPrecoMes', {
    type: 'line',
    data: {
      labels: labelsMes.length ? labelsMes : ['Sem dados'],
      datasets: [{
        label: 'Preço médio por litro (R$)',
        data: mesesOrdenados.length ? mesesOrdenados.map(m => porMes[m].qtdPreco ? (porMes[m].somaPreco/porMes[m].qtdPreco).toFixed(2) : null) : [0],
        borderColor: '#f2c94c',
        backgroundColor: 'rgba(242,201,76,0.15)',
        tension: 0.3,
        fill: true,
        pointBackgroundColor: '#f2c94c'
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { grid: { display: false }, ticks: { color: chartCoresTexto } },
        y: { grid: { color: chartCoresGrid }, ticks: { color: chartCoresTexto } }
      }
    }
  });

  const comConsumoRanking = ranking.filter(v => v.consumoMedio !== null).slice(0, 8);
  criarOuAtualizarChart('chartConsumoVeiculo', {
    type: 'bar',
    data: {
      labels: comConsumoRanking.length ? comConsumoRanking.map(v => v.placa) : ['Sem dados'],
      datasets: [{
        label: 'km/l',
        data: comConsumoRanking.length ? comConsumoRanking.map(v => v.consumoMedio.toFixed(1)) : [0],
        backgroundColor: 'rgba(111,207,151,0.7)',
        borderRadius: 4
      }]
    },
    options: {
      indexAxis: 'y',
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { grid: { color: chartCoresGrid }, ticks: { color: chartCoresTexto } },
        y: { grid: { display: false }, ticks: { color: chartCoresTexto } }
      }
    }
  });
}

function renderListaFrotaAbastecimentos(){
  const el = document.getElementById('listaFrotaAbastecimentos');
  if(!el) return;
  if(frotaAbastecimentos.length === 0){
    el.innerHTML = '<div class="empty">Nenhum abastecimento registrado ainda.</div>';
    return;
  }
  const ordenados = [...frotaAbastecimentos].sort((a,b) => {
    const da = a.data && a.data.toDate ? a.data.toDate() : new Date(0);
    const db_ = b.data && b.data.toDate ? b.data.toDate() : new Date(0);
    return db_ - da;
  });
  el.innerHTML = ordenados.map(r => {
    const veiculo = veiculos.find(v => v.id === r.veiculoId);
    return `<div class="frota-registro">
      <div>
        <div class="placa">${veiculo ? veiculo.placa : 'Veículo removido'}</div>
        <div class="meta">${fmtDate(r.data)} • ${r.motoristaNome || 'motorista'} • ${tiposLabelGlobal[r.tipoCombustivel] || r.tipoCombustivel || ''}${r.posto ? ' • ' + r.posto : ''}</div>
      </div>
      <div class="valores">${fmtNum(r.kmAtual,0)} km<br>${fmtBRL(r.valorReais)}</div>
      <div class="frota-actions">
        <button class="icon-btn" onclick="abrirEdicao('${r.id}')" title="Editar">✎</button>
        <button class="icon-btn danger" onclick="excluirRegistroFrota('${r.id}')" title="Excluir">✕</button>
      </div>
    </div>`;
  }).join('');
}

let relatorioAtual = [];

document.getElementById('btnGerarRelatorio').addEventListener('click', () => {
  const dataIni = document.getElementById('relDataIni').value;
  const dataFim = document.getElementById('relDataFim').value;
  const veiculoId = document.getElementById('relVeiculo').value;
  const motoristaUidFiltro = document.getElementById('relMotorista').value;
  const tipo = document.getElementById('relTipo').value;

  const inicio = dataIni ? new Date(dataIni + 'T00:00:00') : null;
  const fim = dataFim ? new Date(dataFim + 'T23:59:59') : null;

  relatorioAtual = frotaAbastecimentos.filter(r => {
    if(!r.data || !r.data.toDate) return false;
    const d = r.data.toDate();
    if(inicio && d < inicio) return false;
    if(fim && d > fim) return false;
    if(veiculoId && r.veiculoId !== veiculoId) return false;
    if(motoristaUidFiltro && r.motoristaUid !== motoristaUidFiltro) return false;
    if(tipo && r.tipoCombustivel !== tipo) return false;
    return true;
  }).sort((a,b) => a.data.toDate() - b.data.toDate());

  const gastoTotal = relatorioAtual.reduce((s,r) => s + (r.valorReais||0), 0);
  const litrosTotal = relatorioAtual.reduce((s,r) => s + (r.litros||0), 0);
  const precoMedio = litrosTotal > 0 ? gastoTotal / litrosTotal : null;

  document.getElementById('relGastoTotal').textContent = fmtBRL(gastoTotal);
  document.getElementById('relLitrosTotal').textContent = fmtNum(litrosTotal,1) + ' L';
  document.getElementById('relQtdRegistros').textContent = relatorioAtual.length;
  document.getElementById('relPrecoMedio').textContent = precoMedio !== null ? fmtBRL(precoMedio) : 'R$ --';
  document.getElementById('relQtd').textContent = relatorioAtual.length;

  document.getElementById('cardRelatorioResumo').style.display = 'block';
  document.getElementById('cardRelatorioLista').style.display = 'block';

  const listaEl = document.getElementById('relatorioList');
  if(relatorioAtual.length === 0){
    listaEl.innerHTML = '<div class="empty">Nenhum registro encontrado com esses filtros.</div>';
    return;
  }
  listaEl.innerHTML = relatorioAtual.map(r => {
    const veiculo = veiculos.find(v => v.id === r.veiculoId);
    return `<div class="frota-registro">
      <div>
        <div class="placa">${veiculo ? veiculo.placa : 'Veículo removido'}</div>
        <div class="meta">${fmtDate(r.data)} • ${r.motoristaNome || 'motorista'} • ${tiposLabelGlobal[r.tipoCombustivel] || r.tipoCombustivel || ''}</div>
      </div>
      <div class="valores">${fmtNum(r.kmAtual,0)} km<br>${fmtBRL(r.valorReais)}</div>
    </div>`;
  }).join('');
});

function montarLinhasRelatorio(){
  return relatorioAtual.map(r => {
    const veiculo = veiculos.find(v => v.id === r.veiculoId);
    return {
      'Data': fmtDate(r.data),
      'Veículo': veiculo ? veiculo.placa : 'Removido',
      'Motorista': r.motoristaNome || '',
      'Km': r.kmAtual || 0,
      'Litros': r.litros || 0,
      'Valor (R$)': r.valorReais || 0,
      'Combustível': tiposLabelGlobal[r.tipoCombustivel] || r.tipoCombustivel || '',
      'Posto': r.posto || '',
      'Observações': r.observacoes || ''
    };
  });
}

document.getElementById('btnExportarCSV').addEventListener('click', () => {
  if(relatorioAtual.length === 0){ alert('Gere o relatório primeiro.'); return; }
  const linhas = montarLinhasRelatorio();
  const cabecalho = Object.keys(linhas[0]);
  const csv = [
    cabecalho.join(';'),
    ...linhas.map(l => cabecalho.map(c => String(l[c]).replace(/;/g,',')).join(';'))
  ].join('\n');
  const blob = new Blob(['\uFEFF' + csv], {type: 'text/csv;charset=utf-8;'});
  baixarArquivo(blob, 'relatorio-abastecimento.csv');
});

document.getElementById('btnExportarExcel').addEventListener('click', () => {
  if(relatorioAtual.length === 0){ alert('Gere o relatório primeiro.'); return; }
  if(typeof XLSX === 'undefined'){ alert('Biblioteca de Excel não carregou. Verifique sua conexão.'); return; }
  const linhas = montarLinhasRelatorio();
  const ws = XLSX.utils.json_to_sheet(linhas);
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, 'Abastecimentos');
  XLSX.writeFile(wb, 'relatorio-abastecimento.xlsx');
});

document.getElementById('btnExportarPDF').addEventListener('click', () => {
  if(relatorioAtual.length === 0){ alert('Gere o relatório primeiro.'); return; }
  if(typeof window.jspdf === 'undefined'){ alert('Biblioteca de PDF não carregou. Verifique sua conexão.'); return; }
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF();
  const linhas = montarLinhasRelatorio();

  doc.setFontSize(14);
  doc.text('Relatório de Abastecimento', 14, 16);
  doc.setFontSize(9);
  doc.setTextColor(120);
  doc.text('Gerado em ' + new Date().toLocaleString('pt-BR'), 14, 22);

  const gastoTotal = relatorioAtual.reduce((s,r) => s + (r.valorReais||0), 0);
  const litrosTotal = relatorioAtual.reduce((s,r) => s + (r.litros||0), 0);
  doc.text('Total: ' + fmtBRL(gastoTotal) + '  •  ' + fmtNum(litrosTotal,1) + ' L  •  ' + relatorioAtual.length + ' registros', 14, 28);

  doc.autoTable({
    startY: 34,
    head: [Object.keys(linhas[0])],
    body: linhas.map(l => Object.values(l).map(v => typeof v === 'number' ? String(v) : v)),
    styles: { fontSize: 8 },
    headStyles: { fillColor: [255, 122, 26] }
  });

  doc.save('relatorio-abastecimento.pdf');
});

function baixarArquivo(blob, nomeArquivo){
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = nomeArquivo;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

function abrirNovoAbastecimento(){
  const selectVeiculo = document.getElementById('editVeiculo');
  selectVeiculo.innerHTML = veiculos.filter(v => v.ativo !== false).map(v => `<option value="${v.id}">${v.placa}${v.modelo ? ' - ' + v.modelo : ''}</option>`).join('');
  selectVeiculo.value = '';

  document.getElementById('editKm').value = '';
  document.getElementById('editLitros').value = '';
  document.getElementById('editValor').value = '';
  document.getElementById('editTipo').value = 'gasolina_comum';
  document.getElementById('editPosto').value = '';
  document.getElementById('editObs').value = '';
  document.getElementById('editData').value = hojeISO();
  atualizarHintKmModal();

  document.getElementById('editModalTitulo').textContent = 'Novo abastecimento';
  document.getElementById('editMsg').textContent = '';
  document.getElementById('editModal').dataset.editId = '';
  document.getElementById('editModal').classList.add('show');
}

function atualizarHintKmModal(){
  const veiculoId = document.getElementById('editVeiculo').value;
  const hint = document.getElementById('editVeiculoKmHint');
  const v = veiculos.find(x => x.id === veiculoId);
  hint.textContent = v ? 'Km atual registrado: ' + fmtNum(v.kmAtual,0) + ' km' : '';
}
document.getElementById('editVeiculo').addEventListener('change', atualizarHintKmModal);

function abrirEdicao(id){
  const r = frotaAbastecimentos.find(x => x.id === id);
  if(!r) return;

  const selectVeiculo = document.getElementById('editVeiculo');
  selectVeiculo.innerHTML = veiculos.map(v => `<option value="${v.id}">${v.placa}${v.modelo ? ' - ' + v.modelo : ''}</option>`).join('');
  selectVeiculo.value = r.veiculoId;
  atualizarHintKmModal();

  document.getElementById('editKm').value = r.kmAtual;
  document.getElementById('editLitros').value = r.litros;
  document.getElementById('editValor').value = r.valorReais;
  document.getElementById('editTipo').value = r.tipoCombustivel || 'gasolina_comum';
  document.getElementById('editPosto').value = r.posto || '';
  document.getElementById('editObs').value = r.observacoes || '';
  const dataObj = r.data && r.data.toDate ? r.data.toDate() : new Date();
  const tz = dataObj.getTimezoneOffset() * 60000;
  document.getElementById('editData').value = new Date(dataObj - tz).toISOString().slice(0,10);

  document.getElementById('editModalTitulo').textContent = 'Editar abastecimento';
  document.getElementById('editMsg').textContent = '';
  document.getElementById('editModal').dataset.editId = id;
  document.getElementById('editModal').classList.add('show');
}

document.getElementById('btnCancelarEdicao').addEventListener('click', () => {
  document.getElementById('editModal').classList.remove('show');
});

document.getElementById('btnSalvarEdicao').addEventListener('click', async () => {
  const id = document.getElementById('editModal').dataset.editId;
  const ehNovo = !id;
  const msg = document.getElementById('editMsg');
  const veiculoId = document.getElementById('editVeiculo').value;
  const km = parseFloat(document.getElementById('editKm').value);
  const litros = parseFloat(document.getElementById('editLitros').value);
  const valor = parseFloat(document.getElementById('editValor').value);
  const tipo = document.getElementById('editTipo').value;
  const posto = document.getElementById('editPosto').value.trim();
  const obs = document.getElementById('editObs').value.trim();
  const dataInput = document.getElementById('editData').value;

  if(!km || km <= 0 || !litros || litros <= 0 || !valor || valor <= 0 || !veiculoId){
    msg.textContent = 'Preencha veículo, km, litros e valor corretamente.';
    msg.className = 'msg err';
    return;
  }

  if(ehNovo){
    const veiculoSelecionado = veiculos.find(v => v.id === veiculoId);
    const kmAtualVeiculo = veiculoSelecionado ? (veiculoSelecionado.kmAtual || 0) : 0;
    if(km <= kmAtualVeiculo){
      msg.textContent = 'O km informado deve ser maior que o km atual desse veículo (' + fmtNum(kmAtualVeiculo,0) + ').';
      msg.className = 'msg err';
      return;
    }
  }

  const btn = document.getElementById('btnSalvarEdicao');
  btn.disabled = true;
  try{
    if(ehNovo){
      await db.collection('empresas').doc(empresaId).collection('abastecimentos').add({
        veiculoId,
        motoristaUid: uid,
        motoristaNome: (nomeUsuarioAtual || 'Admin') + ' (admin)',
        kmAtual: km,
        litros,
        valorReais: valor,
        tipoCombustivel: tipo,
        emViagem: false,
        posto: posto || null,
        observacoes: obs || null,
        data: firebase.firestore.Timestamp.fromDate(new Date(dataInput + 'T12:00:00')),
        criadoEm: firebase.firestore.FieldValue.serverTimestamp()
      });
      db.collection('empresas').doc(empresaId).collection('veiculos').doc(veiculoId)
        .update({ kmAtual: km })
        .catch(() => {});
    } else {
      await db.collection('empresas').doc(empresaId).collection('abastecimentos').doc(id).update({
        veiculoId,
        kmAtual: km,
        litros,
        valorReais: valor,
        tipoCombustivel: tipo,
        posto: posto || null,
        observacoes: obs || null,
        data: firebase.firestore.Timestamp.fromDate(new Date(dataInput + 'T12:00:00'))
      });
    }
    document.getElementById('editModal').classList.remove('show');
  }catch(e){
    msg.textContent = 'Erro ao salvar: ' + e.message;
    msg.className = 'msg err';
  }
  btn.disabled = false;
});

async function excluirRegistroFrota(id){
  if(!confirm('Excluir este abastecimento? Essa ação não pode ser desfeita.')) return;
  try{
    await db.collection('empresas').doc(empresaId).collection('abastecimentos').doc(id).delete();
  }catch(e){
    alert('Erro ao excluir: ' + e.message);
  }
}

const categoriaLabel = {
  troca_oleo:'Troca de óleo', pneus:'Pneus', freios:'Freios', revisao:'Revisão geral',
  suspensao:'Suspensão', bateria:'Bateria', eletrica:'Elétrica/Eletrônica',
  ar_condicionado:'Ar-condicionado', outro:'Outro'
};

let manutencoesRef = null;
let manutencoes = [];

function initManutencoes(){
  manutencoesRef = db.collection('empresas').doc(empresaId).collection('manutencoes');
  const query = userRole === 'admin' ? manutencoesRef : manutencoesRef.where('motoristaUid', '==', uid);
  document.getElementById('tituloListaManutencao').textContent = userRole === 'admin' ? 'Manutenções da frota' : 'Minhas manutenções registradas';

  query.onSnapshot(snap => {
    manutencoes = [];
    snap.forEach(doc => manutencoes.push({id: doc.id, ...doc.data()}));
    manutencoes.sort((a,b) => {
      const da = a.data && a.data.toDate ? a.data.toDate() : new Date(0);
      const db_ = b.data && b.data.toDate ? b.data.toDate() : new Date(0);
      return db_ - da;
    });
    renderManutencoes();
  }, err => {
    document.getElementById('manutencaoList').innerHTML = '<div class="empty">Erro ao carregar: ' + err.message + '</div>';
  });
}

function renderManutencoes(){
  const el = document.getElementById('manutencaoList');
  if(manutencoes.length === 0){
    el.innerHTML = '<div class="empty">Nenhuma manutenção registrada ainda.</div>';
    return;
  }
  el.innerHTML = manutencoes.map(m => {
    const veiculo = veiculos.find(v => v.id === m.veiculoId);
    const acoesAdmin = userRole === 'admin' ? `
      <div class="frota-actions">
        <button class="icon-btn" onclick="abrirEdicaoManutencao('${m.id}')" title="Editar">✎</button>
        <button class="icon-btn danger" onclick="excluirManutencao('${m.id}')" title="Excluir">✕</button>
      </div>` : '';
    return `<div class="frota-registro">
      <div>
        <div class="placa">${veiculo ? veiculo.placa : 'Veículo removido'}</div>
        <div class="meta">${fmtDate(m.data)}${userRole === 'admin' ? ' • ' + (m.motoristaNome || 'motorista') : ''} • ${categoriaLabel[m.categoria] || m.categoria}</div>
        <div style="margin-top:4px;"><span class="tag ${m.tipo}">${m.tipo === 'preventiva' ? 'Preventiva' : 'Corretiva'}</span></div>
        ${m.descricao ? `<div class="meta" style="margin-top:4px;">${m.descricao}</div>` : ''}
      </div>
      <div class="valores">${m.valor ? fmtBRL(m.valor) : '--'}${m.kmAtual ? '<br>' + fmtNum(m.kmAtual,0) + ' km' : ''}</div>
      ${acoesAdmin}
    </div>`;
  }).join('');
}

document.getElementById('btnSalvarManutencao').addEventListener('click', async () => {
  const msg = document.getElementById('manutencaoMsg');
  const veiculoId = document.getElementById('manVeiculo').value;
  const categoria = document.getElementById('manCategoria').value;
  const km = parseFloat(document.getElementById('manKm').value) || null;
  const valor = parseFloat(document.getElementById('manValor').value) || null;
  const oficina = document.getElementById('manOficina').value.trim();
  const descricao = document.getElementById('manDescricao').value.trim();
  const obs = document.getElementById('manObs').value.trim();
  const proximoKm = parseFloat(document.getElementById('manProximoKm').value) || null;
  const proximaData = document.getElementById('manProximaData').value || null;
  const ehPreventiva = tipoManutencao === 'preventiva';

  msg.textContent = '';
  msg.className = 'msg';

  if(!veiculoId){
    msg.textContent = 'Selecione o veículo.';
    msg.className = 'msg err';
    return;
  }
  if(!descricao){
    msg.textContent = 'Descreva o que precisa ser feito.';
    msg.className = 'msg err';
    return;
  }
  if(ehPreventiva && !proximoKm && !proximaData){
    msg.textContent = 'Preventiva precisa de um km alvo, uma data alvo, ou os dois.';
    msg.className = 'msg err';
    return;
  }
  if(!manutencoesRef){
    msg.textContent = 'Aguarde a sincronização com a empresa.';
    msg.className = 'msg err';
    return;
  }

  const btn = document.getElementById('btnSalvarManutencao');
  btn.disabled = true;
  try{
    if(ehPreventiva){
      // Preventiva não gera manutenção "feita" ainda — só o agendamento.
      // O registro de verdade (com valor/oficina) só nasce quando confirmar no Alertas.
      await salvarComConexaoObrigatoria(() => db.collection('empresas').doc(empresaId).collection('manutencoesProgramadas').add({
        veiculoId,
        categoria,
        descricao,
        kmAlvo: proximoKm || null,
        dataAlvo: proximaData || null,
        status: 'pendente',
        criadoPor: uid,
        criadoEm: firebase.firestore.FieldValue.serverTimestamp()
      }));
      msg.textContent = 'Manutenção preventiva agendada — acompanhe na aba Alertas.';
    } else {
      // Corretiva: já aconteceu, registra direto.
      await salvarComConexaoObrigatoria(() => manutencoesRef.add({
        veiculoId,
        motoristaUid: uid,
        motoristaNome: nomeUsuarioAtual || null,
        tipo: 'corretiva',
        categoria,
        kmAtual: km,
        valor,
        oficina: oficina || null,
        descricao,
        observacoes: obs || null,
        data: firebase.firestore.FieldValue.serverTimestamp()
      }));

      // Corretiva também pode deixar agendado o próximo cuidado, se preenchido.
      if(proximoKm || proximaData){
        db.collection('empresas').doc(empresaId).collection('manutencoesProgramadas').add({
          veiculoId,
          categoria,
          descricao: 'Próxima: ' + descricao,
          kmAlvo: proximoKm || null,
          dataAlvo: proximaData || null,
          status: 'pendente',
          criadoPor: uid,
          criadoEm: firebase.firestore.FieldValue.serverTimestamp()
        }).catch(() => {});
      }
      msg.textContent = 'Manutenção registrada.' + ((proximoKm || proximaData) ? ' Alerta programado criado.' : '');
    }

    document.getElementById('manKm').value = '';
    document.getElementById('manValor').value = '';
    document.getElementById('manOficina').value = '';
    document.getElementById('manDescricao').value = '';
    document.getElementById('manObs').value = '';
    document.getElementById('manProximoKm').value = '';
    document.getElementById('manProximaData').value = '';
    document.getElementById('manVeiculoKmHint').textContent = '';
    tipoManutencao = 'preventiva';
    document.querySelectorAll('#grpTipoManutencao .toggle-btn').forEach(x => x.classList.toggle('active', x.dataset.value === 'preventiva'));
    atualizarFormularioManutencao();
    msg.className = 'msg ok';
  }catch(e){
    msg.textContent = 'Erro ao salvar: ' + e.message;
    msg.className = 'msg err';
  }
  btn.disabled = false;
});

function abrirEdicaoManutencao(id){
  const m = manutencoes.find(x => x.id === id);
  if(!m) return;

  const selectVeiculo = document.getElementById('editManVeiculo');
  selectVeiculo.innerHTML = veiculos.map(v => `<option value="${v.id}">${v.placa}${v.modelo ? ' - ' + v.modelo : ''}</option>`).join('');
  selectVeiculo.value = m.veiculoId;

  document.getElementById('editManTipo').value = m.tipo || 'preventiva';
  document.getElementById('editManCategoria').value = m.categoria || 'outro';
  document.getElementById('editManKm').value = m.kmAtual || '';
  document.getElementById('editManValor').value = m.valor || '';
  document.getElementById('editManOficina').value = m.oficina || '';
  document.getElementById('editManDescricao').value = m.descricao || '';
  document.getElementById('editManObs').value = m.observacoes || '';
  const dataObj = m.data && m.data.toDate ? m.data.toDate() : new Date();
  const tz = dataObj.getTimezoneOffset() * 60000;
  document.getElementById('editManData').value = new Date(dataObj - tz).toISOString().slice(0,10);

  document.getElementById('editManMsg').textContent = '';
  document.getElementById('editManutencaoModal').dataset.editId = id;
  document.getElementById('editManutencaoModal').classList.add('show');
}

document.getElementById('btnCancelarEdicaoManutencao').addEventListener('click', () => {
  document.getElementById('editManutencaoModal').classList.remove('show');
});

document.getElementById('btnSalvarEdicaoManutencao').addEventListener('click', async () => {
  const id = document.getElementById('editManutencaoModal').dataset.editId;
  const msg = document.getElementById('editManMsg');
  const veiculoId = document.getElementById('editManVeiculo').value;
  const tipo = document.getElementById('editManTipo').value;
  const categoria = document.getElementById('editManCategoria').value;
  const km = parseFloat(document.getElementById('editManKm').value) || null;
  const valor = parseFloat(document.getElementById('editManValor').value) || null;
  const oficina = document.getElementById('editManOficina').value.trim();
  const descricao = document.getElementById('editManDescricao').value.trim();
  const obs = document.getElementById('editManObs').value.trim();
  const dataInput = document.getElementById('editManData').value;

  if(!veiculoId || !descricao){
    msg.textContent = 'Preencha veículo e descrição.';
    msg.className = 'msg err';
    return;
  }

  const btn = document.getElementById('btnSalvarEdicaoManutencao');
  btn.disabled = true;
  try{
    await db.collection('empresas').doc(empresaId).collection('manutencoes').doc(id).update({
      veiculoId, tipo, categoria,
      kmAtual: km, valor,
      oficina: oficina || null,
      descricao,
      observacoes: obs || null,
      data: firebase.firestore.Timestamp.fromDate(new Date(dataInput + 'T12:00:00'))
    });
    document.getElementById('editManutencaoModal').classList.remove('show');
  }catch(e){
    msg.textContent = 'Erro ao salvar: ' + e.message;
    msg.className = 'msg err';
  }
  btn.disabled = false;
});

async function excluirManutencao(id){
  if(!confirm('Excluir este registro de manutenção? Essa ação não pode ser desfeita.')) return;
  try{
    await db.collection('empresas').doc(empresaId).collection('manutencoes').doc(id).delete();
  }catch(e){
    alert('Erro ao excluir: ' + e.message);
  }
}

let alertasRef = null;
let alertasProgramados = [];

function initAlertas(){
  alertasRef = db.collection('empresas').doc(empresaId).collection('manutencoesProgramadas');
  alertasRef.onSnapshot(snap => {
    alertasProgramados = [];
    snap.forEach(doc => alertasProgramados.push({id: doc.id, ...doc.data()}));
    renderAlertas();
  }, err => {
    const el = document.getElementById('alertasList');
    if(el) el.innerHTML = '<div class="empty">Erro ao carregar alertas: ' + err.message + '</div>';
  });
}

function calcularUrgencia(alerta){
  // Retorna {status: 'vencido'|'atencao'|'programado', motivo: texto}
  const veiculo = veiculos.find(v => v.id === alerta.veiculoId);
  const kmAtualVeiculo = veiculo ? (veiculo.kmAtual || 0) : null;
  const hoje = new Date();
  hoje.setHours(0,0,0,0);

  let piorStatus = 'programado';
  const motivos = [];

  if(alerta.kmAlvo && kmAtualVeiculo !== null){
    const faltam = alerta.kmAlvo - kmAtualVeiculo;
    if(faltam <= 0){
      piorStatus = 'vencido';
      motivos.push(`${fmtNum(Math.abs(faltam),0)} km acima do previsto`);
    } else if(faltam <= 500){
      if(piorStatus !== 'vencido') piorStatus = 'atencao';
      motivos.push(`faltam ${fmtNum(faltam,0)} km`);
    } else {
      motivos.push(`faltam ${fmtNum(faltam,0)} km`);
    }
  }

  if(alerta.dataAlvo){
    const dataAlvo = new Date(alerta.dataAlvo + 'T12:00:00');
    const diffDias = Math.round((dataAlvo - hoje) / (1000*60*60*24));
    if(diffDias <= 0){
      piorStatus = 'vencido';
      motivos.push(diffDias === 0 ? 'vence hoje' : `${Math.abs(diffDias)} dia(s) atrasado`);
    } else if(diffDias <= 7){
      if(piorStatus !== 'vencido') piorStatus = 'atencao';
      motivos.push(`em ${diffDias} dia(s)`);
    } else {
      motivos.push(`em ${diffDias} dia(s)`);
    }
  }

  return {status: piorStatus, motivo: motivos.join(' • '), veiculo};
}

function renderAlertas(){
  const listAtivos = document.getElementById('alertasList');
  const listConcluidos = document.getElementById('alertasConcluidosList');

  const ativosParaResumo = alertasProgramados.filter(a => a.status !== 'concluida');
  const comUrgenciaResumo = ativosParaResumo.map(a => calcularUrgencia(a));
  const qtdVencidos = comUrgenciaResumo.filter(u => u.status === 'vencido').length;
  const qtdAtencao = comUrgenciaResumo.filter(u => u.status === 'atencao').length;
  const cardResumo = document.getElementById('cardResumoAlertas');
  if(cardResumo){
    if(qtdVencidos + qtdAtencao > 0){
      cardResumo.style.display = 'block';
      const partes = [];
      if(qtdVencidos) partes.push(qtdVencidos + ' vencida' + (qtdVencidos !== 1 ? 's' : ''));
      if(qtdAtencao) partes.push(qtdAtencao + ' próxima' + (qtdAtencao !== 1 ? 's' : '') + ' do prazo');
      document.getElementById('resumoAlertasTexto').textContent = partes.join(' e ') + '. Veja na aba Alertas.';
    } else {
      cardResumo.style.display = 'none';
    }
  }

  if(!listAtivos || !listConcluidos) return;

  const categoriaLabelLocal = categoriaLabel;
  const ativos = alertasProgramados.filter(a => a.status !== 'concluida');
  const concluidos = alertasProgramados.filter(a => a.status === 'concluida');

  if(ativos.length === 0){
    listAtivos.innerHTML = '<div class="empty">Nenhuma manutenção programada ativa.</div>';
  } else {
    const comUrgencia = ativos.map(a => ({...a, _urg: calcularUrgencia(a)}));
    const ordem = {vencido: 0, atencao: 1, programado: 2};
    comUrgencia.sort((a,b) => ordem[a._urg.status] - ordem[b._urg.status]);

    const labelStatus = {vencido: 'Vencido', atencao: 'Atenção', programado: 'Programado'};

    listAtivos.innerHTML = comUrgencia.map(a => {
      const v = a._urg.veiculo;
      return `<div class="alerta-item">
        <div class="alerta-head">
          <div>
            <div class="placa">${v ? v.placa : 'Veículo removido'}</div>
            <div class="desc">${categoriaLabelLocal[a.categoria] || a.categoria} — ${a.descricao}</div>
          </div>
          <span class="tag ${a._urg.status}">${labelStatus[a._urg.status]}</span>
        </div>
        <div class="alerta-meta">
          ${a.kmAlvo ? 'Alvo: ' + fmtNum(a.kmAlvo,0) + ' km' : ''}${a.kmAlvo && a.dataAlvo ? ' • ' : ''}${a.dataAlvo ? 'até ' + new Date(a.dataAlvo+'T12:00:00').toLocaleDateString('pt-BR') : ''}
          <br>${a._urg.motivo}
        </div>
        ${userRole === 'admin' ? `<div class="alerta-actions">
          <button class="icon-btn" onclick="concluirAlerta('${a.id}')" title="Marcar como concluída">✓ Concluir</button>
          <button class="icon-btn danger" onclick="excluirAlerta('${a.id}')" title="Excluir">✕</button>
        </div>` : ''}
      </div>`;
    }).join('');
  }

  if(concluidos.length === 0){
    listConcluidos.innerHTML = '<div class="empty">Nenhuma ainda.</div>';
  } else {
    listConcluidos.innerHTML = concluidos.map(a => {
      const v = veiculos.find(x => x.id === a.veiculoId);
      return `<div class="alerta-item">
        <div class="alerta-head">
          <div>
            <div class="placa">${v ? v.placa : 'Veículo removido'}</div>
            <div class="desc">${categoriaLabelLocal[a.categoria] || a.categoria} — ${a.descricao}</div>
          </div>
          <button class="icon-btn danger" onclick="excluirAlerta('${a.id}')" title="Excluir">✕</button>
        </div>
      </div>`;
    }).join('');
  }
}

document.getElementById('btnSalvarAlerta').addEventListener('click', async () => {
  const msg = document.getElementById('alertaMsg');
  const veiculoId = document.getElementById('alVeiculo').value;
  const categoria = document.getElementById('alCategoria').value;
  const descricao = document.getElementById('alDescricao').value.trim();
  const kmAlvo = parseFloat(document.getElementById('alKmAlvo').value) || null;
  const dataAlvo = document.getElementById('alDataAlvo').value || null;

  msg.textContent = '';
  msg.className = 'msg';

  if(!veiculoId || !descricao){
    msg.textContent = 'Selecione o veículo e descreva a manutenção.';
    msg.className = 'msg err';
    return;
  }
  if(!kmAlvo && !dataAlvo){
    msg.textContent = 'Informe um km alvo, uma data alvo, ou os dois.';
    msg.className = 'msg err';
    return;
  }
  if(!alertasRef){
    msg.textContent = 'Aguarde a sincronização com a empresa.';
    msg.className = 'msg err';
    return;
  }

  const btn = document.getElementById('btnSalvarAlerta');
  btn.disabled = true;
  try{
    await alertasRef.add({
      veiculoId, categoria, descricao,
      kmAlvo: kmAlvo || null,
      dataAlvo: dataAlvo || null,
      status: 'pendente',
      criadoEm: firebase.firestore.FieldValue.serverTimestamp()
    });
    document.getElementById('alDescricao').value = '';
    document.getElementById('alKmAlvo').value = '';
    document.getElementById('alDataAlvo').value = '';
    msg.textContent = 'Manutenção programada.';
    msg.className = 'msg ok';
  }catch(e){
    msg.textContent = 'Erro ao salvar: ' + e.message;
    msg.className = 'msg err';
  }
  btn.disabled = false;
});

function concluirAlerta(id){
  const alerta = alertasProgramados.find(a => a.id === id);
  if(!alerta) return;
  const veiculo = veiculos.find(v => v.id === alerta.veiculoId);

  document.getElementById('concluirAlertaResumo').textContent =
    (veiculo ? veiculo.placa : 'Veículo removido') + ' — ' + (categoriaLabel[alerta.categoria] || alerta.categoria) + ': ' + alerta.descricao;
  document.getElementById('concluirValor').value = '';
  document.getElementById('concluirOficina').value = '';
  document.getElementById('concluirKm').value = veiculo ? (veiculo.kmAtual || '') : '';
  document.getElementById('concluirAlertaMsg').textContent = '';
  document.getElementById('concluirAlertaModal').dataset.alertaId = id;
  document.getElementById('concluirAlertaModal').classList.add('show');
}

document.getElementById('btnCancelarConclusao').addEventListener('click', () => {
  document.getElementById('concluirAlertaModal').classList.remove('show');
});

document.getElementById('btnConfirmarConclusao').addEventListener('click', async () => {
  const modal = document.getElementById('concluirAlertaModal');
  const id = modal.dataset.alertaId;
  const alerta = alertasProgramados.find(a => a.id === id);
  const msg = document.getElementById('concluirAlertaMsg');
  const valor = parseFloat(document.getElementById('concluirValor').value) || null;
  const oficina = document.getElementById('concluirOficina').value.trim();
  const km = parseFloat(document.getElementById('concluirKm').value) || null;

  if(!alerta) return;
  if(!valor || !oficina){
    msg.textContent = 'Preencha valor e oficina.';
    msg.className = 'msg err';
    return;
  }

  const btn = document.getElementById('btnConfirmarConclusao');
  btn.disabled = true;
  try{
    await manutencoesRef.add({
      veiculoId: alerta.veiculoId,
      motoristaUid: uid,
      motoristaNome: nomeUsuarioAtual || null,
      tipo: 'preventiva',
      categoria: alerta.categoria,
      kmAtual: km,
      valor,
      oficina,
      descricao: alerta.descricao,
      observacoes: null,
      data: firebase.firestore.FieldValue.serverTimestamp()
    });
    await alertasRef.doc(id).update({ status: 'concluida', concluidoEm: firebase.firestore.FieldValue.serverTimestamp() });
    modal.classList.remove('show');
  }catch(e){
    msg.textContent = 'Erro ao confirmar: ' + e.message;
    msg.className = 'msg err';
  }
  btn.disabled = false;
});

async function excluirAlerta(id){
  if(!confirm('Excluir este alerta programado?')) return;
  try{
    await alertasRef.doc(id).delete();
  }catch(e){
    alert('Erro ao excluir: ' + e.message);
  }
}

document.getElementById('btnGerarSenha').addEventListener('click', () => {
  const chars = 'ABCDEFGHJKMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789';
  let senha = '';
  for(let i = 0; i < 8; i++) senha += chars[Math.floor(Math.random() * chars.length)];
  document.getElementById('motSenha').value = senha;
});

let papelMembroSelecionado = 'motorista';
document.querySelectorAll('#grpPapelMembro .toggle-btn').forEach(b => {
  b.addEventListener('click', () => {
    document.querySelectorAll('#grpPapelMembro .toggle-btn').forEach(x => x.classList.remove('active'));
    b.classList.add('active');
    papelMembroSelecionado = b.dataset.value;
  });
});

document.getElementById('btnConvidarMotorista').addEventListener('click', async () => {
  const msg = document.getElementById('motoristaMsg');
  const papel = papelMembroSelecionado;
  const nome = document.getElementById('motNome').value.trim();
  const email = document.getElementById('motEmail').value.trim().toLowerCase();
  const senha = document.getElementById('motSenha').value;

  msg.textContent = '';
  msg.className = 'msg';

  if(!nome || !email || !senha){
    msg.textContent = 'Preencha nome, e-mail e senha.';
    msg.className = 'msg err';
    return;
  }
  if(!/^\S+@\S+\.\S+$/.test(email)){
    msg.textContent = 'E-mail inválido.';
    msg.className = 'msg err';
    return;
  }
  if(senha.length < 6){
    msg.textContent = 'A senha precisa ter pelo menos 6 caracteres.';
    msg.className = 'msg err';
    return;
  }
  if(!membrosRef){
    msg.textContent = 'Aguarde a sincronização com a empresa.';
    msg.className = 'msg err';
    return;
  }
  const btn = document.getElementById('btnConvidarMotorista');
  btn.disabled = true;
  try{
    const existente = await membrosRef.doc(email).get();
    if(existente.exists){
      msg.textContent = 'Já existe alguém com esse e-mail nessa empresa.';
      msg.className = 'msg err';
      btn.disabled = false;
      return;
    }

    // Verifica se esse e-mail já tem conta em ALGUM lugar do sistema (pode ser
    // de uma empresa anterior, ex: motorista demitido que mudou de emprego).
    const metodosExistentes = await secondaryAuth.fetchSignInMethodsForEmail(email);
    const contaJaExiste = metodosExistentes && metodosExistentes.length > 0;

    if(contaJaExiste){
      // Não dá pra criar de novo (e-mail já é único no Firebase). Em vez disso,
      // cria um convite pendente — quando a pessoa logar com a senha que ela
      // JÁ TEM, o app reconhece automaticamente e vincula nessa empresa.
      await membrosRef.doc(email).set({
        nome,
        email,
        role: papel,
        status: 'pendente',
        uid: null,
        convidadoEm: firebase.firestore.FieldValue.serverTimestamp()
      });
      await db.collection('convites').doc(email).set({
        nome,
        email,
        role: papel,
        empresaId,
        status: 'pendente',
        criadoEm: firebase.firestore.FieldValue.serverTimestamp()
      });

      document.getElementById('motNome').value = '';
      document.getElementById('motEmail').value = '';
      document.getElementById('motSenha').value = '';
      msg.innerHTML = 'Esse e-mail já tem conta no sistema (provavelmente de outra empresa). Convite criado — a pessoa entra com a senha que já usa, e cai direto aqui. <a href="javascript:void(0)" onclick="copiarConvite(\'' + nome.replace(/'/g,"\\'") + '\',\'' + email + '\')" style="color:var(--amber);text-decoration:underline;">Copiar aviso pra enviar</a>';
      msg.className = 'msg ok';
      btn.disabled = false;
      return;
    }

    // E-mail novo — cria a conta de verdade, pronta pra usar.
    // Cria na instância secundária, o que NÃO afeta a sessão do admin.
    const cred = await secondaryAuth.createUserWithEmailAndPassword(email, senha);
    const novoUid = cred.user.uid;
    await secondaryAuth.signOut();

    if(papel === 'admin'){
      // Checa e reserva a vaga de admin de forma atômica (mesmo padrão do limite de veículos).
      const empresaRef = db.collection('empresas').doc(empresaId);
      await db.runTransaction(async (tx) => {
        const empresaSnap = await tx.get(empresaRef);
        tx.set(db.collection('usuarios').doc(novoUid), {
          empresaId, role: 'admin', nome, email,
          criadoEm: firebase.firestore.FieldValue.serverTimestamp()
        });
        tx.update(empresaRef, { adminsCount: firebase.firestore.FieldValue.increment(1) });
      });
    } else {
      await db.collection('usuarios').doc(novoUid).set({
        empresaId, role: 'motorista', nome, email,
        criadoEm: firebase.firestore.FieldValue.serverTimestamp()
      });
    }

    await membrosRef.doc(email).set({
      nome,
      email,
      role: papel,
      status: 'ativo',
      uid: novoUid,
      convidadoEm: firebase.firestore.FieldValue.serverTimestamp()
    });

    document.getElementById('motNome').value = '';
    document.getElementById('motEmail').value = '';
    document.getElementById('motSenha').value = '';
    msg.innerHTML = (papel === 'admin' ? 'Administrador criado.' : 'Motorista criado.') + ' <a href="javascript:void(0)" onclick="copiarConvite(\'' + nome.replace(/'/g,"\\'") + '\',\'' + email + '\',\'' + senha.replace(/'/g,"\\'") + '\')" style="color:var(--amber);text-decoration:underline;">Copiar acesso pra enviar</a>';
    msg.className = 'msg ok';
  }catch(e){
    if(e.code === 'auth/email-already-in-use'){
      msg.textContent = 'Já existe uma conta com esse e-mail no sistema.';
    } else if(e.code === 'auth/weak-password'){
      msg.textContent = 'Senha muito fraca (mínimo 6 caracteres).';
    } else if(e.code === 'auth/invalid-email'){
      msg.textContent = 'E-mail inválido.';
    } else {
      msg.textContent = 'Erro ao criar: ' + e.message;
    }
    msg.className = 'msg err';
  }
  btn.disabled = false;
});

document.getElementById('btnCriarEmpresa').addEventListener('click', async () => {
  const msg = document.getElementById('empresaMsg');
  const nome = document.getElementById('empNome').value.trim();
  const razaoSocial = document.getElementById('empRazaoSocial').value.trim();
  const responsavel = document.getElementById('empResponsavel').value.trim();
  const cnpj = document.getElementById('empCnpj').value.trim();
  const telefone = document.getElementById('empTelefone').value.trim();
  const emailFinanceiro = document.getElementById('empEmailFinanceiro').value.trim();
  const endereco = document.getElementById('empEndereco').value.trim();
  const cep = document.getElementById('empCep').value.trim();
  const cidade = document.getElementById('empCidade').value.trim();
  const estado = document.getElementById('empEstado').value;
  const qtdVeiculos = document.getElementById('empQtdVeiculos').value;

  msg.textContent = '';
  msg.className = 'msg';

  if(!nome || !responsavel){
    msg.textContent = 'Preencha ao menos o nome da empresa e o nome do responsável.';
    msg.className = 'msg err';
    return;
  }
  if(emailFinanceiro && !/^\S+@\S+\.\S+$/.test(emailFinanceiro)){
    msg.textContent = 'E-mail financeiro inválido.';
    msg.className = 'msg err';
    return;
  }
  if(!usuarioPendente){
    msg.textContent = 'Sessão expirada, faça login novamente.';
    msg.className = 'msg err';
    return;
  }

  const btn = document.getElementById('btnCriarEmpresa');
  btn.disabled = true;
  try{
    const user = usuarioPendente;
    const empresaRef = db.collection('empresas').doc();
    await empresaRef.set({
      nome,
      razaoSocial: razaoSocial || null,
      cnpj: cnpj || null,
      telefone: telefone || null,
      emailFinanceiro: emailFinanceiro || null,
      endereco: endereco || null,
      cep: cep || null,
      cidade: cidade || null,
      estado: estado || null,
      qtdVeiculos,
      donoUid: user.uid,
      plano: 'free',
      limiteVeiculos: LIMITE_ILIMITADO,
      veiculosCount: 0,
      limiteAdmins: LIMITE_ILIMITADO,
      adminsCount: 1,
      criadoEm: firebase.firestore.FieldValue.serverTimestamp()
    });

    await db.collection('usuarios').doc(user.uid).set({
      empresaId: empresaRef.id,
      role: 'admin',
      email: user.email || null,
      nome: responsavel,
      criadoEm: firebase.firestore.FieldValue.serverTimestamp()
    });

    if(user.email){
      await empresaRef.collection('membros').doc(user.email.toLowerCase()).set({
        nome: responsavel,
        email: user.email.toLowerCase(),
        role: 'admin',
        status: 'ativo',
        uid: user.uid,
        convidadoEm: firebase.firestore.FieldValue.serverTimestamp()
      });
    }

    empresaId = empresaRef.id;
    userRole = 'admin';
    usuarioPendente = null;
    await entrarNoApp();
  }catch(e){
    msg.textContent = 'Erro ao criar empresa: ' + e.message;
    msg.className = 'msg err';
  }
  btn.disabled = false;
});

try{
  firebase.initializeApp(firebaseConfig);
  db = firebase.firestore();
  auth = firebase.auth();
  auth.setPersistence(firebase.auth.Auth.Persistence.LOCAL);

  // Instância separada do Firebase, usada só pra criar a conta do motorista.
  // Criar um usuário sempre loga automaticamente com ele — usando essa instância
  // paralela, isso acontece "isolado" e não afeta a sessão do admin no app principal.
  const secondaryApp = firebase.initializeApp(firebaseConfig, 'Secondary');
  secondaryAuth = secondaryApp.auth();

  auth.onAuthStateChanged(async user => {
    if(user){
      uid = user.uid;
      let resultado;
      try{
        resultado = await resolverEmpresa(user);
      }catch(e){
        // Nunca deixa a tela em branco: se algo inesperado falhar aqui, volta
        // pro login com o erro visível, em vez de travar tudo escondido.
        mostrarTela(loginScreen);
        setStatus('erro ao verificar empresa: ' + e.message, 'off');
        return;
      }

      if(resultado === 'existente' || resultado === 'convite'){
        usuarioPendente = null;
        await entrarNoApp();
      } else {
        usuarioPendente = user;
        document.getElementById('empResponsavel').value = user.displayName || '';
        mostrarTela(setupEmpresaScreen);
        setStatus('complete o cadastro da empresa para continuar', 'off');
      }
    } else {
      uid = null;
      empresaId = null;
      userRole = null;
      usuarioPendente = null;
      colRef = null;
      entries = [];
      mostrarTela(loginScreen);
      setStatus('faça login para sincronizar', 'off');
    }
  });
}catch(e){
  loginScreen.classList.add('show');
  setStatus('configure o firebaseConfig no código para ativar a sincronização', 'off');
}

document.getElementById('toggleLink').addEventListener('click', () => {
  modoCriarConta = !modoCriarConta;
  document.getElementById('loginTitle').textContent = modoCriarConta ? 'Criar conta' : 'Entrar';
  document.getElementById('btnLogin').textContent = modoCriarConta ? 'Criar conta' : 'Entrar';
  document.getElementById('toggleText').textContent = modoCriarConta ? 'Já tem conta?' : 'Ainda não tem conta?';
  document.getElementById('toggleLink').textContent = modoCriarConta ? 'Entrar' : 'Criar conta';
  document.getElementById('loginMsg').textContent = '';
});

document.getElementById('linkEsqueciSenha').addEventListener('click', async () => {
  const msg = document.getElementById('loginMsg');
  const email = document.getElementById('loginEmail').value.trim();
  msg.textContent = '';
  msg.className = 'msg';

  if(!email || !/^\S+@\S+\.\S+$/.test(email)){
    msg.textContent = 'Digite seu e-mail no campo acima primeiro, depois clique em "Esqueci minha senha".';
    msg.className = 'msg err';
    return;
  }
  if(!auth){
    msg.textContent = 'Firebase não configurado ainda.';
    msg.className = 'msg err';
    return;
  }
  try{
    await auth.sendPasswordResetEmail(email);
    msg.textContent = 'Enviamos um e-mail pra ' + email + ' com um link pra você criar uma senha nova.';
    msg.className = 'msg ok';
  }catch(e){
    if(e.code === 'auth/user-not-found'){
      msg.textContent = 'Não existe conta com esse e-mail.';
    } else {
      msg.textContent = 'Erro ao enviar: ' + e.message;
    }
    msg.className = 'msg err';
  }
});

document.getElementById('btnLogin').addEventListener('click', async () => {
  const email = document.getElementById('loginEmail').value.trim();
  const senha = document.getElementById('loginSenha').value;
  const msg = document.getElementById('loginMsg');
  msg.textContent = '';
  msg.className = 'msg';

  if(!email || !senha || senha.length < 6){
    msg.textContent = 'Informe um e-mail válido e senha com pelo menos 6 caracteres.';
    msg.className = 'msg err';
    return;
  }
  if(!auth){
    msg.textContent = 'Firebase não configurado ainda.';
    msg.className = 'msg err';
    return;
  }
  const btn = document.getElementById('btnLogin');
  btn.disabled = true;
  try{
    if(modoCriarConta){
      await auth.createUserWithEmailAndPassword(email, senha);
    } else {
      await auth.signInWithEmailAndPassword(email, senha);
    }
  }catch(e){
    msg.textContent = traduzErroAuth(e);
    msg.className = 'msg err';
  }
  btn.disabled = false;
});

document.getElementById('btnLogout').addEventListener('click', () => {
  if(auth) auth.signOut();
});

document.getElementById('btnGoogleLogin').addEventListener('click', async () => {
  const msg = document.getElementById('loginMsg');
  msg.textContent = '';
  msg.className = 'msg';
  if(!auth){
    msg.textContent = 'Firebase não configurado ainda.';
    msg.className = 'msg err';
    return;
  }
  try{
    const provider = new firebase.auth.GoogleAuthProvider();
    await auth.signInWithPopup(provider);
  }catch(e){
    if(e.code !== 'auth/popup-closed-by-user'){
      msg.textContent = traduzErroAuth(e);
      msg.className = 'msg err';
    }
  }
});

function traduzErroAuth(e){
  const map = {
    'auth/email-already-in-use': 'Esse e-mail já tem uma conta. Tente entrar.',
    'auth/invalid-email': 'E-mail inválido.',
    'auth/weak-password': 'Senha muito fraca (mínimo 6 caracteres).',
    'auth/user-not-found': 'Conta não encontrada. Crie uma conta primeiro.',
    'auth/wrong-password': 'Senha incorreta.',
    'auth/invalid-credential': 'E-mail ou senha incorretos.',
    'auth/unauthorized-domain': 'Este domínio não está autorizado no Firebase (adicione-o em Authentication > Settings > Authorized domains).',
    'auth/popup-blocked': 'O navegador bloqueou a janela de login do Google. Permita pop-ups e tente de novo.'
  };
  return map[e.code] || ('Erro: ' + e.message);
}

function listenEntries(){
  entriesQueryRef.onSnapshot(snap => {
    entries = [];
    snap.forEach(doc => entries.push({id: doc.id, ...doc.data()}));
    entries.sort((a,b) => {
      const da = a.data && a.data.toDate ? a.data.toDate() : new Date(0);
      const db_ = b.data && b.data.toDate ? b.data.toDate() : new Date(0);
      return da - db_;
    });
    render();
  }, err => {
    setStatus('erro ao ler dados: ' + err.message, 'off');
  });
}

const tabIds = {dashboard: 'tabDashboard', veiculos: 'tabVeiculos', motoristas: 'tabMotoristas', configuracoes: 'tabConfiguracoes', abastecimento: 'tabAbastecimento', manutencao: 'tabManutencao', alertas: 'tabAlertas', relatorios: 'tabRelatorios'};
document.querySelectorAll('.tab-btn').forEach(b => {
  b.addEventListener('click', () => {
    document.querySelectorAll('.tab-btn').forEach(x => x.classList.remove('active'));
    document.querySelectorAll('.tab-panel').forEach(x => x.classList.remove('active'));
    b.classList.add('active');
    document.getElementById(tabIds[b.dataset.tab]).classList.add('active');
    fecharMenuLateral();
  });
});


function fecharMenuLateral(){
  const nav = document.getElementById('tabNav');
  if(!nav) return;
  nav.classList.remove('expanded');
  document.getElementById('navBackdrop').classList.remove('show');
  document.getElementById('navToggle').setAttribute('aria-expanded','false');
}
document.getElementById('navToggle').addEventListener('click', () => {
  const nav = document.getElementById('tabNav');
  const abrir = !nav.classList.contains('expanded');
  nav.classList.toggle('expanded', abrir);
  document.getElementById('navBackdrop').classList.toggle('show', abrir);
  document.getElementById('navToggle').setAttribute('aria-expanded', abrir ? 'true' : 'false');
});
document.getElementById('navBackdrop').addEventListener('click', fecharMenuLateral);
document.addEventListener('keydown', e => { if(e.key === 'Escape') fecharMenuLateral(); });

let emViagem = 'nao';
let tipoManutencao = 'preventiva';

document.querySelectorAll('#grpTipoManutencao .toggle-btn').forEach(b => {
  b.addEventListener('click', () => {
    document.querySelectorAll('#grpTipoManutencao .toggle-btn').forEach(x => x.classList.remove('active'));
    b.classList.add('active');
    tipoManutencao = b.dataset.value;
    atualizarFormularioManutencao();
  });
});

function atualizarFormularioManutencao(){
  const ehPreventiva = tipoManutencao === 'preventiva';
  document.getElementById('campoValorOficina').style.display = ehPreventiva ? 'none' : 'grid';
  document.getElementById('campoManKm').style.display = ehPreventiva ? 'none' : 'block';
  document.getElementById('labelProximoKm').textContent = ehPreventiva ? 'Agendar para o km *' : 'Próxima manutenção no km (opcional)';
  document.getElementById('labelProximaData').textContent = ehPreventiva ? 'Ou até a data *' : 'Ou até a data (opcional)';
  document.getElementById('manProximaHint').textContent = ehPreventiva
    ? 'Preencha o km, a data, ou os dois — a manutenção fica como alerta programado até você confirmar que foi feita (aí sim pede valor e oficina).'
    : 'Preenchendo qualquer um dos dois, o app também cria um alerta programado pra esse veículo.';
  document.getElementById('manTipoHint').style.display = ehPreventiva ? 'block' : 'none';
  document.getElementById('btnSalvarManutencao').textContent = ehPreventiva ? 'Agendar manutenção preventiva' : 'Registrar manutenção';
}
atualizarFormularioManutencao();

