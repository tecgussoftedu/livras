<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>FrotaGo</title>
<meta name="description" content="Controle de abastecimento e consumo da frota">
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#0d0f12">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="FrotaGo">
<link rel="apple-touch-icon" href="/icons/icon-180.png">
<link rel="icon" type="image/png" sizes="32x32" href="/icons/icon-32.png">
<link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0d0f12;
    --panel:#16191d;
    --panel-2:#1d2126;
    --line:#272c32;
    --amber:#ff7a1a;
    --yellow:#f2c94c;
    --text:#f5f5f0;
    --muted:#8b929b;
    --good:#6fcf97;
    --bad:#eb5757;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:'Rajdhani',sans-serif;
    min-height:100vh;
    display:flex;
    justify-content:center;
  }
  #app{
    width:100%;
    max-width:460px;
    padding:20px 16px 60px;
  }
  .eyebrow{
    font-size:12px;
    letter-spacing:3px;
    color:var(--muted);
    text-transform:uppercase;
    font-weight:600;
  }
  h1{
    margin:2px 0 20px;
    font-size:26px;
    font-weight:700;
    letter-spacing:0.5px;
  }
  h1 span{color:var(--amber);}

  .gauge-wrap{
    position:relative;
    width:220px;
    height:220px;
    margin:0 auto 22px;
  }
  .gauge-wrap svg{width:100%;height:100%;transform:rotate(-90deg);}
  .gauge-bg{fill:none;stroke:var(--panel-2);stroke-width:14;}
  .gauge-fg{fill:none;stroke:var(--amber);stroke-width:14;stroke-linecap:round;transition:stroke-dashoffset .6s ease;}
  .gauge-center{
    position:absolute;inset:0;
    display:flex;flex-direction:column;align-items:center;justify-content:center;
  }
  .gauge-value{
    font-family:'JetBrains Mono',monospace;
    font-size:38px;font-weight:700;color:var(--yellow);
    line-height:1;
  }
  .gauge-unit{font-size:13px;color:var(--muted);margin-top:4px;letter-spacing:1px;}
  .gauge-label{font-size:11px;color:var(--muted);letter-spacing:2px;text-transform:uppercase;margin-top:2px;}

  .stats{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
    margin-bottom:22px;
  }
  .stat{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:10px;
    padding:12px 14px;
  }
  .stat .label{font-size:11px;color:var(--muted);letter-spacing:1px;text-transform:uppercase;}
  .stat .value{
    font-family:'JetBrains Mono',monospace;
    font-size:19px;font-weight:700;margin-top:4px;color:var(--text);
  }

  .card{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:12px;
    padding:16px;
    margin-bottom:18px;
  }
  .card h2{
    font-size:15px;font-weight:700;letter-spacing:1px;text-transform:uppercase;
    margin:0 0 14px;color:var(--amber);
    display:flex;align-items:center;gap:8px;
  }
  .field{margin-bottom:12px;}
  .field label{
    display:block;font-size:12px;color:var(--muted);margin-bottom:5px;letter-spacing:0.5px;
  }
  .field input{
    width:100%;
    background:var(--panel-2);
    border:1px solid var(--line);
    border-radius:8px;
    color:var(--text);
    font-family:'JetBrains Mono',monospace;
    font-size:16px;
    padding:11px 12px;
    outline:none;
  }
  .field input:focus{border-color:var(--amber);}
  .field select{
    width:100%;
    background:var(--panel-2);
    border:1px solid var(--line);
    border-radius:8px;
    color:var(--text);
    font-family:'Rajdhani',sans-serif;
    font-size:15px;
    font-weight:600;
    padding:11px 12px;
    outline:none;
    appearance:none;
    -webkit-appearance:none;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='%238b929b' stroke-width='2'><polyline points='6 9 12 15 18 9'/></svg>");
    background-repeat:no-repeat;
    background-position:right 12px center;
  }
  .field select:focus{border-color:var(--amber);}
  .field textarea{
    width:100%;
    background:var(--panel-2);
    border:1px solid var(--line);
    border-radius:8px;
    color:var(--text);
    font-family:'Rajdhani',sans-serif;
    font-size:15px;
    padding:11px 12px;
    outline:none;
    resize:vertical;
  }
  .field textarea:focus{border-color:var(--amber);}
  .row2{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .hint{font-size:12px;color:var(--muted);margin-top:6px;}
  .hint b{color:var(--yellow);}

  .toggle-group{
    display:flex;
    background:var(--panel-2);
    border:1px solid var(--line);
    border-radius:8px;
    overflow:hidden;
  }
  .toggle-btn{
    flex:1;
    background:none;
    border:none;
    color:var(--muted);
    font-family:'Rajdhani',sans-serif;
    font-weight:600;
    font-size:14px;
    padding:10px 6px;
    cursor:pointer;
  }
  .toggle-btn.active{
    background:var(--amber);
    color:#1a0e02;
  }

  .tag{
    display:inline-block;
    font-size:10px;
    font-weight:700;
    letter-spacing:0.5px;
    text-transform:uppercase;
    padding:2px 7px;
    border-radius:20px;
    margin-top:4px;
    margin-right:4px;
  }
  .tag.aditivada{background:rgba(242,201,76,0.15);color:var(--yellow);}
  .tag.viagem{background:rgba(255,122,26,0.15);color:var(--amber);}
  .tag.posto{background:rgba(139,146,155,0.15);color:var(--muted);}

  .tab-nav{
    position:fixed;
    top:0;bottom:0;
    left:max(0px, calc((100vw - 460px) / 2));
    width:52px;
    max-width:80vw;
    z-index:60;
    display:flex;
    flex-direction:column;
    gap:4px;
    background:var(--panel);
    border-right:1px solid var(--line);
    padding:calc(8px + env(safe-area-inset-top, 0px)) 6px calc(8px + env(safe-area-inset-bottom, 0px));
    overflow-x:hidden;
    overflow-y:auto;
    scrollbar-width:none;
    transition:width .2s ease, box-shadow .2s ease;
  }
  .tab-nav::-webkit-scrollbar{display:none;}
  .tab-nav.expanded{width:220px;box-shadow:8px 0 24px rgba(0,0,0,0.5);}
  .nav-backdrop{
    display:none;position:fixed;inset:0;z-index:55;
    background:rgba(0,0,0,0.55);
  }
  .nav-backdrop.show{display:block;}
  .tab-btn, .nav-toggle{
    flex:0 0 auto;
    width:100%;
    height:44px;
    display:flex;
    align-items:center;
    justify-content:flex-start;
    gap:12px;
    white-space:nowrap;
    background:none;
    border:none;
    color:#9aa1aa;
    font-family:'Rajdhani',sans-serif;
    font-weight:700;
    font-size:15px;
    letter-spacing:0.2px;
    padding:0 10px;
    border-radius:12px;
    cursor:pointer;
    transition:color .15s ease, background .15s ease, box-shadow .15s ease;
  }
  .tab-btn > span:last-child, .nav-toggle > span:last-child{display:none;}
  .tab-nav.expanded .tab-btn > span:last-child,
  .tab-nav.expanded .nav-toggle > span:last-child{display:inline;}
  .nav-toggle{
    color:var(--text);
    margin-bottom:6px;
    border-bottom:1px solid var(--line);
    border-radius:12px 12px 0 0;
    height:48px;
  }
  .tab-ico{position:relative;display:flex;flex-shrink:0;}
  .tab-btn svg, .nav-toggle svg{
    width:20px;height:20px;flex-shrink:0;
    fill:none;stroke:currentColor;stroke-width:1.75;
    stroke-linecap:round;stroke-linejoin:round;
  }
  .tab-btn:hover, .nav-toggle:hover{color:var(--text);}
  .tab-btn:focus-visible, .nav-toggle:focus-visible{outline:2px solid var(--amber);outline-offset:1px;}
  .tab-btn.active{
    background:linear-gradient(180deg,#ff9440 0%,var(--amber) 100%);
    color:#1a0e02;
    box-shadow:0 0 0 1px rgba(255,148,64,0.35), 0 3px 10px rgba(255,122,26,0.35), inset 0 1px 0 rgba(255,255,255,0.28);
  }
  .tab-btn[data-tab="configuracoes"]{margin-top:auto;}
  .tab-dot{
    position:absolute;top:-2px;right:-3px;
    width:8px;height:8px;border-radius:50%;
    background:var(--amber);border:1.5px solid var(--panel);
  }
  .tab-dot[hidden]{display:none;}
  .tab-btn.active .tab-dot{background:#1a0e02;border-color:var(--amber);}
  @keyframes tabDotPulse{
    0%{box-shadow:0 0 0 0 rgba(255,122,26,0.55);}
    70%,100%{box-shadow:0 0 0 6px rgba(255,122,26,0);}
  }
  .tab-dot:not([hidden]){animation:tabDotPulse 2.4s ease-out infinite;}
  @media (prefers-reduced-motion:reduce){
    .tab-nav, .tab-btn, .nav-toggle{transition:none;}
    .tab-dot:not([hidden]){animation:none;}
  }
  /* reserva o espaço da barra lateral só depois do login */
  .card canvas{max-width:100%;}
  body.com-menu #app{padding-left:calc(52px + 14px);padding-right:14px;}
  .tab-panel{display:none;}
  .tab-panel.active{display:block;}

  .ranking-item{
    display:flex;justify-content:space-between;align-items:center;
    padding:12px 0;border-bottom:1px solid var(--line);gap:10px;
  }
  .ranking-item:last-child{border-bottom:none;}
  .ranking-pos{
    font-family:'JetBrains Mono',monospace;font-weight:700;color:var(--muted);
    font-size:13px;width:20px;flex-shrink:0;
  }
  .ranking-item .placa{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:14px;}
  .ranking-item .modelo{font-size:11px;color:var(--muted);margin-top:2px;}
  .ranking-right{text-align:right;flex-shrink:0;}
  .ranking-right .consumo{font-family:'JetBrains Mono',monospace;font-size:14px;color:var(--yellow);font-weight:700;}
  .ranking-right .gasto{font-size:11px;color:var(--muted);margin-top:2px;}

  .modal-overlay{
    display:none;
    position:fixed;inset:0;
    background:rgba(0,0,0,0.7);
    z-index:100;
    align-items:flex-end;
    justify-content:center;
  }
  .modal-overlay.show{display:flex;}
  .modal-card{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:16px 16px 0 0;
    padding:20px 16px 30px;
    width:100%;
    max-width:460px;
    max-height:88vh;
    overflow-y:auto;
  }
  .frota-registro{
    display:flex;justify-content:space-between;align-items:center;
    padding:12px 0;border-bottom:1px solid var(--line);gap:10px;
  }
  .frota-registro:last-child{border-bottom:none;}
  .frota-registro .placa{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:14px;}
  .frota-registro .meta{font-size:11px;color:var(--muted);margin-top:2px;}
  .frota-registro .valores{text-align:right;font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--yellow);}
  .frota-actions{display:flex;gap:6px;}
  .icon-btn{
    background:var(--panel-2);border:1px solid var(--line);border-radius:6px;
    color:var(--muted);font-size:14px;padding:6px 9px;cursor:pointer;
  }
  .icon-btn:active{border-color:var(--amber);color:var(--amber);}
  .icon-btn.danger:active{border-color:var(--bad);color:var(--bad);}

  .checklist-item{
    display:flex;align-items:center;gap:12px;
    padding:11px 0;border-bottom:1px solid var(--line);
    cursor:pointer;
  }
  .checklist-item:last-child{border-bottom:none;}
  .checklist-check{
    width:22px;height:22px;border-radius:50%;flex-shrink:0;
    display:flex;align-items:center;justify-content:center;
    border:2px solid var(--line);font-size:12px;font-weight:700;
  }
  .checklist-item.done .checklist-check{
    background:var(--good);border-color:var(--good);color:#0d1a12;
  }
  .checklist-item.done .checklist-text .titulo{
    color:var(--muted);text-decoration:line-through;
  }
  .checklist-text .titulo{font-size:14px;font-weight:600;}
  .checklist-text .sub{font-size:11px;color:var(--muted);margin-top:1px;}

  .plano-item{
    border:1px solid var(--line);
    border-radius:10px;
    padding:14px;
    margin-bottom:10px;
  }
  .plano-item:last-child{margin-bottom:0;}
  .plano-item.atual{
    border-color:var(--amber);
    background:rgba(255,122,26,0.06);
  }
  .plano-head{display:flex;justify-content:space-between;align-items:center;}
  .plano-nome{font-size:15px;font-weight:700;}
  .plano-preco{font-family:'JetBrains Mono',monospace;font-size:15px;font-weight:700;color:var(--yellow);}
  .plano-preco .periodo{font-size:11px;color:var(--muted);font-weight:400;}
  .plano-limites{font-size:12px;color:var(--muted);margin-top:6px;}
  .plano-badge-atual{
    display:inline-block;margin-top:8px;
    font-size:10px;font-weight:700;letter-spacing:0.5px;text-transform:uppercase;
    padding:3px 8px;border-radius:20px;
    background:rgba(255,122,26,0.18);color:var(--amber);
  }

  .tag.preventiva{background:rgba(111,207,151,0.15);color:var(--good);}
  .tag.corretiva{background:rgba(235,87,87,0.15);color:var(--bad);}

  .tag.vencido{background:rgba(235,87,87,0.18);color:var(--bad);}
  .tag.atencao{background:rgba(242,201,76,0.18);color:var(--yellow);}
  .tag.programado{background:rgba(139,146,155,0.15);color:var(--muted);}

  .alerta-item{
    padding:12px 0;border-bottom:1px solid var(--line);
  }
  .alerta-item:last-child{border-bottom:none;}
  .alerta-head{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;}
  .alerta-head .placa{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:14px;}
  .alerta-head .desc{font-size:12px;color:var(--muted);margin-top:2px;}
  .alerta-meta{font-size:11px;color:var(--muted);margin-top:6px;}
  .alerta-actions{display:flex;gap:6px;margin-top:8px;}

  .veiculo-item{
    display:flex;justify-content:space-between;align-items:center;
    padding:12px 0;border-bottom:1px solid var(--line);
  }
  .veiculo-item:last-child{border-bottom:none;}
  .veiculo-item .placa{
    font-family:'JetBrains Mono',monospace;font-size:15px;font-weight:700;letter-spacing:1px;
  }
  .veiculo-item .modelo{font-size:12px;color:var(--muted);margin-top:2px;text-transform:capitalize;}
  .veiculo-item .km{
    font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--yellow);text-align:right;
  }

  .motorista-item{
    display:flex;justify-content:space-between;align-items:center;
    padding:12px 0;border-bottom:1px solid var(--line);gap:10px;
  }
  .motorista-item:last-child{border-bottom:none;}
  .motorista-item .nome{font-size:14px;font-weight:600;}
  .motorista-item .email{font-size:12px;color:var(--muted);margin-top:2px;}
  .motorista-item .veiculo-vinc{font-size:11px;color:var(--muted);margin-top:2px;}
  .status-badge{
    font-size:10px;font-weight:700;letter-spacing:0.5px;text-transform:uppercase;
    padding:3px 8px;border-radius:20px;white-space:nowrap;
  }
  .status-badge.pendente{background:rgba(242,201,76,0.15);color:var(--yellow);}
  .status-badge.ativo{background:rgba(111,207,151,0.15);color:var(--good);}
  .mot-right{display:flex;align-items:center;gap:8px;}

  .predict-row{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
    margin-bottom:10px;
  }
  .predict-item{
    background:var(--panel-2);
    border:1px solid var(--line);
    border-radius:10px;
    padding:14px;
    text-align:center;
  }
  .predict-label{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;}
  .predict-value{
    font-family:'JetBrains Mono',monospace;
    font-size:18px;font-weight:700;color:var(--yellow);margin-top:6px;
  }

  .intervalo-item{
    display:flex;justify-content:space-between;align-items:center;
    padding:10px 0;
    border-bottom:1px solid var(--line);
    font-size:13px;
  }
  .intervalo-item:last-child{border-bottom:none;}
  .intervalo-item .periodo{color:var(--muted);font-size:12px;}
  .intervalo-item .valores{
    font-family:'JetBrains Mono',monospace;
    text-align:right;
    font-size:13px;
  }

  .spark-legend{
    display:flex;justify-content:space-between;
    font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px;margin-top:4px;
  }

  .insight-list{
    list-style:none;margin:0;padding:0;
  }
  .insight-list li{
    position:relative;
    padding:9px 0 9px 20px;
    border-bottom:1px solid var(--line);
    font-size:14px;
    line-height:1.4;
  }
  .insight-list li:last-child{border-bottom:none;}
  .insight-list li::before{
    content:"▸";
    position:absolute;left:0;top:9px;
    color:var(--amber);font-weight:700;
  }
  .insight-list li b{color:var(--yellow);}

  .records-row{
    display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:18px;
  }
  .record-card{
    border-radius:12px;padding:14px;border:1px solid var(--line);
  }
  .record-card.good{background:rgba(111,207,151,0.08);border-color:rgba(111,207,151,0.3);}
  .record-card.bad{background:rgba(235,87,87,0.08);border-color:rgba(235,87,87,0.3);}
  .record-label{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;}
  .record-value{
    font-family:'JetBrains Mono',monospace;font-size:22px;font-weight:700;margin-top:6px;
  }
  .record-card.good .record-value{color:var(--good);}
  .record-card.bad .record-value{color:var(--bad);}
  .record-sub{font-size:11px;color:var(--muted);margin-top:3px;}

  .comp-bar-item{margin-bottom:14px;}
  .comp-bar-item:last-child{margin-bottom:0;}
  .comp-bar-head{
    display:flex;justify-content:space-between;font-size:13px;margin-bottom:5px;
  }
  .comp-bar-head .nome{color:var(--text);font-weight:600;}
  .comp-bar-head .num{font-family:'JetBrains Mono',monospace;color:var(--yellow);}
  .comp-bar-track{
    height:8px;background:var(--panel-2);border-radius:5px;overflow:hidden;
  }
  .comp-bar-fill{
    height:100%;background:var(--amber);border-radius:5px;transition:width .5s ease;
  }
  .comp-bar-note{font-size:11px;color:var(--muted);margin-top:3px;}

  button.submit{
    width:100%;
    background:var(--amber);
    color:#1a0e02;
    border:none;
    border-radius:8px;
    padding:13px;
    font-family:'Rajdhani',sans-serif;
    font-size:16px;
    font-weight:700;
    letter-spacing:1px;
    text-transform:uppercase;
    cursor:pointer;
    margin-top:4px;
  }
  button.submit:active{transform:scale(0.98);}
  button.submit:disabled{opacity:0.5;}

  .msg{font-size:13px;margin-top:10px;text-align:center;}
  .msg.err{color:var(--bad);}
  .msg.ok{color:var(--good);}

  .history-item{
    display:flex;justify-content:space-between;align-items:center;
    padding:12px 0;
    border-bottom:1px solid var(--line);
  }
  .history-item:last-child{border-bottom:none;}
  .hi-left .km{font-family:'JetBrains Mono',monospace;font-size:15px;font-weight:700;}
  .hi-left .date{font-size:11px;color:var(--muted);margin-top:2px;}
  .hi-right{text-align:right;}
  .hi-right .cons{font-family:'JetBrains Mono',monospace;font-size:14px;color:var(--yellow);font-weight:700;}
  .hi-right .rs{font-size:11px;color:var(--muted);margin-top:2px;}
  .del-btn{
    background:none;border:none;color:var(--muted);font-size:16px;margin-left:10px;cursor:pointer;padding:4px;
  }
  .del-btn:active{color:var(--bad);}

  .empty{
    text-align:center;color:var(--muted);font-size:13px;padding:20px 0;
  }
  .status{
    font-size:11px;color:var(--muted);text-align:center;margin-top:18px;letter-spacing:0.5px;
  }
  .status.on{color:var(--good);}
  .status.off{color:var(--bad);}

  #loginScreen{display:none;}
  #loginScreen.show{display:block;}
  #setupEmpresaScreen{display:none;}
  #setupEmpresaScreen.show{display:block;}
  #mainApp{display:none;}
  #mainApp.show{display:block;}
  .login-toggle{
    text-align:center;font-size:13px;color:var(--muted);margin-top:14px;
  }
  .login-toggle a{color:var(--amber);text-decoration:none;font-weight:600;}
  .logout-link{
    display:block;text-align:center;font-size:12px;color:var(--muted);
    margin-top:10px;text-decoration:underline;cursor:pointer;background:none;border:none;
  }

  .or-divider{
    display:flex;align-items:center;text-align:center;
    color:var(--muted);font-size:12px;margin:14px 0;
  }
  .or-divider::before,.or-divider::after{
    content:"";flex:1;height:1px;background:var(--line);
  }
  .or-divider span{padding:0 10px;}

  .google-btn{
    width:100%;
    display:flex;align-items:center;justify-content:center;gap:10px;
    background:#fff;
    color:#3c4043;
    border:1px solid var(--line);
    border-radius:8px;
    padding:11px;
    font-family:'Rajdhani',sans-serif;
    font-size:15px;
    font-weight:600;
    cursor:pointer;
  }
  .google-btn:active{transform:scale(0.98);}
  /* Login com Google temporariamente oculto (reativar: apagar a linha abaixo) */
  .google-btn, .or-divider { display:none !important; }
</style>
</head>
<body>
<div id="app">

  <div class="eyebrow">Controle de abastecimento e frota</div>
  <h1>Frota<span>Go</span></h1>

  <div id="loginScreen">
    <div class="card">
      <h2 id="loginTitle">Entrar</h2>
      <div class="field">
        <label for="loginEmail">E-mail</label>
        <input type="email" id="loginEmail" placeholder="voce@exemplo.com" autocomplete="username">
      </div>
      <div class="field">
        <label for="loginSenha">Senha</label>
        <input type="password" id="loginSenha" placeholder="mínimo 6 caracteres" autocomplete="current-password">
      </div>
      <button class="submit" id="btnLogin">Entrar</button>
      <div class="msg" id="loginMsg"></div>
      <div style="text-align:center;margin-top:10px;">
        <a href="javascript:void(0)" id="linkEsqueciSenha" style="font-size:12px;color:var(--muted);text-decoration:underline;">Esqueci minha senha</a>
      </div>

      <div class="or-divider"><span>ou</span></div>

      <button class="google-btn" id="btnGoogleLogin">
        <svg width="18" height="18" viewBox="0 0 18 18"><path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.9c1.7-1.57 2.7-3.88 2.7-6.62z"/><path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.9-2.26c-.8.54-1.84.86-3.06.86-2.35 0-4.34-1.59-5.05-3.72H.98v2.33A9 9 0 0 0 9 18z"/><path fill="#FBBC05" d="M3.95 10.7A5.4 5.4 0 0 1 3.67 9c0-.59.1-1.17.28-1.7V4.97H.98A9 9 0 0 0 0 9c0 1.45.35 2.83.98 4.03l2.97-2.33z"/><path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0A9 9 0 0 0 .98 4.97l2.97 2.33C4.66 5.17 6.65 3.58 9 3.58z"/></svg>
        Continuar com Google
      </button>

      <div class="login-toggle">
        <span id="toggleText">Ainda não tem conta?</span>
        <a href="javascript:void(0)" id="toggleLink">Criar conta</a>
      </div>
    </div>
    <div class="status" id="connStatusLogin">conectando ao firebase...</div>
    <div style="text-align:center;margin-top:8px;font-size:11px;">
      Ao continuar, você concorda com os
      <a href="/termos.html" style="color:var(--muted);text-decoration:underline;">Termos de Uso</a>
      e a
      <a href="/privacidade.html" style="color:var(--muted);text-decoration:underline;">Política de Privacidade</a>.
    </div>
  </div>

  <div id="setupEmpresaScreen">
    <div class="card">
      <h2>Cadastrar empresa</h2>
      <div class="hint" style="margin-bottom:14px;">Primeiro acesso — preencha os dados da sua empresa para continuar.</div>

      <div class="field">
        <label for="empNome">Nome fantasia *</label>
        <input type="text" id="empNome" placeholder="Ex: Transportes Silva">
      </div>
      <div class="field">
        <label for="empRazaoSocial">Razão Social</label>
        <input type="text" id="empRazaoSocial" placeholder="Ex: Transportes Silva LTDA">
      </div>
      <div class="row2">
        <div class="field">
          <label for="empCnpj">CNPJ</label>
          <input type="text" id="empCnpj" placeholder="00.000.000/0000-00">
        </div>
        <div class="field">
          <label for="empTelefone">Telefone</label>
          <input type="text" id="empTelefone" placeholder="(00) 00000-0000">
        </div>
      </div>
      <div class="field">
        <label for="empEmailFinanceiro">E-mail financeiro / cobrança</label>
        <input type="email" id="empEmailFinanceiro" placeholder="financeiro@empresa.com">
      </div>
      <div class="field">
        <label for="empEndereco">Endereço (rua, número, bairro)</label>
        <input type="text" id="empEndereco" placeholder="Ex: Rua das Flores, 123 - Centro">
      </div>
      <div class="row2">
        <div class="field">
          <label for="empCep">CEP</label>
          <input type="text" id="empCep" placeholder="00000-000">
        </div>
        <div class="field">
          <label for="empCidade">Cidade</label>
          <input type="text" id="empCidade" placeholder="Ex: São Paulo">
        </div>
      </div>
      <div class="field">
        <label for="empEstado">Estado</label>
        <select id="empEstado">
          <option value="">Selecione</option>
          <option>AC</option><option>AL</option><option>AP</option><option>AM</option>
          <option>BA</option><option>CE</option><option>DF</option><option>ES</option>
          <option>GO</option><option>MA</option><option>MT</option><option>MS</option>
          <option>MG</option><option>PA</option><option>PB</option><option>PR</option>
          <option>PE</option><option>PI</option><option>RJ</option><option>RN</option>
          <option>RS</option><option>RO</option><option>RR</option><option>SC</option>
          <option>SP</option><option>SE</option><option>TO</option>
        </select>
      </div>
      <div class="field">
        <label for="empResponsavel">Nome do responsável *</label>
        <input type="text" id="empResponsavel" placeholder="Seu nome completo">
      </div>
      <div class="field">
        <label for="empQtdVeiculos">Tamanho aproximado da frota</label>
        <select id="empQtdVeiculos">
          <option value="1-5">1 a 5 veículos</option>
          <option value="6-15">6 a 15 veículos</option>
          <option value="16-50">16 a 50 veículos</option>
          <option value="50+">Mais de 50 veículos</option>
        </select>
      </div>

      <button class="submit" id="btnCriarEmpresa">Criar empresa e continuar</button>
      <div class="msg" id="empresaMsg"></div>
    </div>
  </div>

  <div id="mainApp">

  <div class="nav-backdrop" id="navBackdrop"></div>
  <div class="tab-nav" id="tabNav">
    <button type="button" class="nav-toggle" id="navToggle" aria-label="Menu" aria-expanded="false" title="Menu"><span class="tab-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="18" y2="18"/></svg></span><span>Menu</span></button>
    <button type="button" aria-label="Dashboard" title="Dashboard" class="tab-btn admin-only" data-tab="dashboard"><span class="tab-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V20a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9.5"/></svg></span><span>Dashboard</span></button>
    <button type="button" aria-label="Alertas" title="Alertas" class="tab-btn" data-tab="alertas"><span class="tab-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg><span class="tab-dot" hidden></span></span><span>Alertas</span></button>
    <button type="button" aria-label="Equipe" title="Equipe" class="tab-btn admin-only" data-tab="motoristas"><span class="tab-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span><span>Equipe</span></button>
    <button type="button" aria-label="Veículos" title="Veículos" class="tab-btn admin-only" data-tab="veiculos"><span class="tab-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg></span><span>Veículos</span></button>
    <button type="button" aria-label="Manutenção" title="Manutenção" class="tab-btn" data-tab="manutencao"><span class="tab-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></span><span>Manutenção</span></button>
    <button type="button" aria-label="Relatórios" title="Relatórios" class="tab-btn admin-only" data-tab="relatorios"><span class="tab-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><rect width="8" height="4" x="8" y="2" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg></span><span>Relatórios</span></button>
    <button type="button" aria-label="Configurações" title="Configurações" class="tab-btn admin-only" data-tab="configuracoes"><span class="tab-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="21" x2="14" y1="4" y2="4"/><line x1="10" x2="3" y1="4" y2="4"/><line x1="21" x2="12" y1="12" y2="12"/><line x1="8" x2="3" y1="12" y2="12"/><line x1="21" x2="16" y1="20" y2="20"/><line x1="12" x2="3" y1="20" y2="20"/><line x1="14" x2="14" y1="2" y2="6"/><line x1="8" x2="8" y1="10" y2="14"/><line x1="16" x2="16" y1="18" y2="22"/></svg></span><span>Configurações</span></button>
    <button type="button" aria-label="Abastecimento" title="Abastecimento" class="tab-btn motorista-only" data-tab="abastecimento"><span class="tab-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="3" x2="15" y1="22" y2="22"/><line x1="4" x2="14" y1="9" y2="9"/><path d="M14 22V4a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v18"/><path d="M14 13h2a2 2 0 0 1 2 2v2a2 2 0 0 0 4 0V9.83a2 2 0 0 0-.59-1.42L18 5"/></svg></span><span>Abastecimento</span></button>
  </div>

  <div id="tabMotoristas" class="tab-panel" data-role-only="admin">

    <div class="card">
      <h2>Criar membro da equipe</h2>
      <div class="field">
        <label>Papel *</label>
        <div class="toggle-group" id="grpPapelMembro">
          <button type="button" class="toggle-btn active" data-value="motorista">Motorista</button>
          <button type="button" class="toggle-btn" data-value="admin">Administrador</button>
        </div>
      </div>
      <div class="field">
        <label for="motNome">Nome *</label>
        <input type="text" id="motNome" placeholder="Ex: João Pereira">
      </div>
      <div class="field">
        <label for="motEmail">E-mail de acesso *</label>
        <input type="email" id="motEmail" placeholder="motorista@exemplo.com">
      </div>
      <div class="field">
        <label for="motSenha">Senha *</label>
        <div style="display:flex;gap:8px;">
          <input type="text" id="motSenha" placeholder="Mínimo 6 caracteres" style="flex:1;">
          <button type="button" class="icon-btn" id="btnGerarSenha" style="padding:0 14px;">Gerar</button>
        </div>
      </div>
      <button class="submit" id="btnConvidarMotorista">Criar</button>
      <div class="msg" id="motoristaMsg"></div>
      <div class="hint">A conta já é criada pronta pra uso — a pessoa só precisa entrar com esse e-mail e senha, sem cadastrar nada.</div>
    </div>

    <div class="card">
      <h2>Equipe da empresa</h2>
      <div id="motoristasList">
        <div class="empty">Ninguém cadastrado ainda.</div>
      </div>
    </div>

  </div>

  <div id="tabDashboard" class="tab-panel" data-role-only="admin">

    <div class="card" id="cardChecklist" style="display:none;">
      <h2>Primeiros passos</h2>
      <div id="checklistList"></div>
    </div>

    <div class="card" id="cardResumoAlertas" style="display:none;">
      <h2 style="color:var(--bad);">⚠ Manutenções pendentes</h2>
      <div id="resumoAlertasTexto" class="hint" style="margin:0;"></div>
    </div>

    <div class="stats">
      <div class="stat">
        <div class="label">Gasto total da frota</div>
        <div class="value" id="fdGastoTotal">R$ --</div>
      </div>
      <div class="stat">
        <div class="label">Custo médio por km</div>
        <div class="value" id="fdCustoKm">R$ --</div>
      </div>
      <div class="stat">
        <div class="label">Km rodados (frota)</div>
        <div class="value" id="fdKmTotal">--</div>
      </div>
      <div class="stat">
        <div class="label">Litros abastecidos</div>
        <div class="value" id="fdLitrosTotal">--</div>
      </div>
    </div>

    <div class="card">
      <h2>Ranking por veículo</h2>
      <div id="rankingVeiculos">
        <div class="empty">Nenhum abastecimento registrado na frota ainda.</div>
      </div>
    </div>

    <div class="card">
      <h2>Gastos por mês</h2>
      <div style="position:relative;height:220px;">
        <canvas id="chartGastosMes"></canvas>
      </div>
    </div>

    <div class="card">
      <h2>Evolução do preço do combustível</h2>
      <div style="position:relative;height:220px;">
        <canvas id="chartPrecoMes"></canvas>
      </div>
    </div>

    <div class="card">
      <h2>Consumo por veículo (km/l)</h2>
      <div style="position:relative;height:220px;">
        <canvas id="chartConsumoVeiculo"></canvas>
      </div>
    </div>

    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:center;">
        <h2 style="margin:0;">Abastecimentos da frota</h2>
        <button class="icon-btn" onclick="abrirNovoAbastecimento()" title="Novo abastecimento">+ Novo</button>
      </div>
      <div id="listaFrotaAbastecimentos" style="margin-top:10px;">
        <div class="empty">Nenhum abastecimento registrado ainda.</div>
      </div>
    </div>

  </div>

  <div id="editModal" class="modal-overlay" data-role-only="admin">
    <div class="modal-card">
      <h2 id="editModalTitulo">Editar abastecimento</h2>
      <div class="field">
        <label for="editVeiculo">Veículo</label>
        <select id="editVeiculo"></select>
        <div class="hint" id="editVeiculoKmHint"></div>
      </div>
      <div class="field">
        <label for="editKm">Km</label>
        <input type="number" id="editKm">
      </div>
      <div class="row2">
        <div class="field">
          <label for="editLitros">Litros</label>
          <input type="number" id="editLitros" step="0.01">
        </div>
        <div class="field">
          <label for="editValor">Valor (R$)</label>
          <input type="number" id="editValor" step="0.01">
        </div>
      </div>
      <div class="row2">
        <div class="field">
          <label for="editTipo">Tipo</label>
          <select id="editTipo">
            <option value="gasolina_comum">Gasolina Comum</option>
            <option value="gasolina_aditivada">Gasolina Aditivada</option>
            <option value="etanol">Etanol</option>
            <option value="diesel_s10">Diesel S10</option>
            <option value="diesel_comum">Diesel Comum</option>
            <option value="gnv">GNV</option>
          </select>
        </div>
        <div class="field">
          <label for="editData">Data</label>
          <input type="date" id="editData">
        </div>
      </div>
      <div class="field">
        <label for="editPosto">Posto</label>
        <input type="text" id="editPosto">
      </div>
      <div class="field">
        <label for="editObs">Observações</label>
        <textarea id="editObs" rows="2"></textarea>
      </div>
      <button class="submit" id="btnSalvarEdicao">Salvar edição</button>
      <button class="logout-link" id="btnCancelarEdicao" style="margin-top:10px;">Cancelar</button>
      <div class="msg" id="editMsg"></div>
    </div>
  </div>

  <div id="editManutencaoModal" class="modal-overlay" data-role-only="admin">
    <div class="modal-card">
      <h2>Editar manutenção</h2>
      <div class="field">
        <label for="editManVeiculo">Veículo</label>
        <select id="editManVeiculo"></select>
      </div>
      <div class="row2">
        <div class="field">
          <label for="editManTipo">Tipo</label>
          <select id="editManTipo">
            <option value="preventiva">Preventiva</option>
            <option value="corretiva">Corretiva</option>
          </select>
        </div>
        <div class="field">
          <label for="editManCategoria">Categoria</label>
          <select id="editManCategoria">
            <option value="troca_oleo">Troca de óleo</option>
            <option value="pneus">Pneus</option>
            <option value="freios">Freios</option>
            <option value="revisao">Revisão geral</option>
            <option value="suspensao">Suspensão</option>
            <option value="bateria">Bateria</option>
            <option value="eletrica">Elétrica/Eletrônica</option>
            <option value="ar_condicionado">Ar-condicionado</option>
            <option value="outro">Outro</option>
          </select>
        </div>
      </div>
      <div class="row2">
        <div class="field">
          <label for="editManKm">Km no momento</label>
          <input type="number" id="editManKm">
        </div>
        <div class="field">
          <label for="editManValor">Valor (R$)</label>
          <input type="number" id="editManValor" step="0.01">
        </div>
      </div>
      <div class="row2">
        <div class="field">
          <label for="editManOficina">Oficina</label>
          <input type="text" id="editManOficina">
        </div>
        <div class="field">
          <label for="editManData">Data</label>
          <input type="date" id="editManData">
        </div>
      </div>
      <div class="field">
        <label for="editManDescricao">Descrição</label>
        <textarea id="editManDescricao" rows="2"></textarea>
      </div>
      <div class="field">
        <label for="editManObs">Observações</label>
        <textarea id="editManObs" rows="2"></textarea>
      </div>
      <button class="submit" id="btnSalvarEdicaoManutencao">Salvar edição</button>
      <button class="logout-link" id="btnCancelarEdicaoManutencao" style="margin-top:10px;">Cancelar</button>
      <div class="msg" id="editManMsg"></div>
    </div>
  </div>

  <div id="editVeiculoModal" class="modal-overlay" data-role-only="admin">
    <div class="modal-card">
      <h2>Editar veículo</h2>
      <div class="field">
        <label for="editVecPlaca">Placa</label>
        <input type="text" id="editVecPlaca" style="text-transform:uppercase;">
      </div>
      <div class="row2">
        <div class="field">
          <label for="editVecMarca">Marca</label>
          <input type="text" id="editVecMarca">
        </div>
        <div class="field">
          <label for="editVecModelo">Modelo</label>
          <input type="text" id="editVecModelo">
        </div>
      </div>
      <div class="row2">
        <div class="field">
          <label for="editVecTipo">Tipo</label>
          <select id="editVecTipo">
            <option value="moto">Moto</option>
            <option value="carro">Carro</option>
            <option value="caminhonete">Caminhonete</option>
            <option value="caminhao">Caminhão</option>
            <option value="outro">Outro</option>
          </select>
        </div>
        <div class="field">
          <label for="editVecAno">Ano</label>
          <input type="number" id="editVecAno">
        </div>
      </div>
      <div class="field">
        <label for="editVecKm">Km atual</label>
        <input type="number" id="editVecKm">
      </div>
      <div class="field">
        <label>Status</label>
        <div class="toggle-group" id="grpVecStatus">
          <button type="button" class="toggle-btn active" data-value="ativo">Ativo</button>
          <button type="button" class="toggle-btn" data-value="inativo">Inativo</button>
        </div>
      </div>
      <button class="submit" id="btnSalvarEdicaoVeiculo">Salvar edição</button>
      <button class="logout-link" id="btnCancelarEdicaoVeiculo" style="margin-top:10px;">Cancelar</button>
      <button class="logout-link" id="btnExcluirVeiculo" style="margin-top:6px;color:var(--bad);">Excluir veículo</button>
      <div class="msg" id="editVecMsg"></div>
    </div>
