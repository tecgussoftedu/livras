function resetToggles(){
  emViagem = 'nao';
  document.querySelectorAll('#grpViagem .toggle-btn').forEach(x => x.classList.toggle('active', x.dataset.value === 'nao'));
}
function hojeISO(){
  const d = new Date();
  const tz = d.getTimezoneOffset() * 60000;
  return new Date(d - tz).toISOString().slice(0,10);
}

document.getElementById('inLitros').addEventListener('input', updatePrecoHint);
document.getElementById('inValor').addEventListener('input', updatePrecoHint);
function updatePrecoHint(){
  const litros = parseFloat(document.getElementById('inLitros').value);
  const valor = parseFloat(document.getElementById('inValor').value);
  const hint = document.getElementById('precoLitroHint');
  if(litros > 0 && valor > 0){
    hint.innerHTML = 'Preço por litro: <b>' + fmtBRL(valor/litros) + '</b>';
  } else {
    hint.innerHTML = 'Preço por litro: <b>--</b>';
  }
}

document.getElementById('abVeiculo').addEventListener('change', () => {
  const veiculoId = document.getElementById('abVeiculo').value;
  const hint = document.getElementById('abVeiculoKmHint');
  const v = veiculos.find(x => x.id === veiculoId);
  hint.textContent = v ? 'Km atual registrado: ' + fmtNum(v.kmAtual,0) + ' km' : '';
});

document.getElementById('btnSalvar').addEventListener('click', async () => {
  const msg = document.getElementById('formMsg');
  const veiculoId = document.getElementById('abVeiculo').value;
  const km = parseFloat(document.getElementById('inKm').value);
  const litros = parseFloat(document.getElementById('inLitros').value);
  const valor = parseFloat(document.getElementById('inValor').value);
  const tipoCombustivel = document.getElementById('inTipo').value;
  const posto = document.getElementById('inPosto').value.trim();
  const obs = document.getElementById('inObs').value.trim();

  msg.textContent = '';
  msg.className = 'msg';

  if(!veiculoId){
    msg.textContent = 'Selecione o veículo.';
    msg.className = 'msg err';
    return;
  }
  if(!km || km <= 0 || !litros || litros <= 0 || !valor || valor <= 0){
    msg.textContent = 'Preencha km, litros e valor corretamente.';
    msg.className = 'msg err';
    return;
  }
  const veiculoSelecionado = veiculos.find(v => v.id === veiculoId);
  const kmAtualVeiculo = veiculoSelecionado ? (veiculoSelecionado.kmAtual || 0) : 0;
  if(km <= kmAtualVeiculo){
    msg.textContent = 'O km informado deve ser maior que o km atual desse veículo (' + fmtNum(kmAtualVeiculo,0) + ').';
    msg.className = 'msg err';
    return;
  }
  if(!colRef){
    msg.textContent = 'Firebase não configurado ainda.';
    msg.className = 'msg err';
    return;
  }
  if(!navigator.onLine){
    msg.textContent = 'Sem conexão com a internet. Conecte-se e tente novamente.';
    msg.className = 'msg err';
    return;
  }

  const btn = document.getElementById('btnSalvar');
  btn.disabled = true;
  try{
    const registro = {
      veiculoId: veiculoId,
      motoristaUid: uid,
      motoristaNome: nomeUsuarioAtual || null,
      kmAtual: km,
      litros: litros,
      valorReais: valor,
      tipoCombustivel: tipoCombustivel,
      emViagem: emViagem === 'sim',
      posto: posto || null,
      observacoes: obs || null,
      data: firebase.firestore.FieldValue.serverTimestamp(),
      criadoEm: firebase.firestore.FieldValue.serverTimestamp()
    };
    await salvarComConexaoObrigatoria(() => colRef.add(registro));

    db.collection('empresas').doc(empresaId).collection('veiculos').doc(veiculoId)
      .update({ kmAtual: km })
      .catch(() => { /* atualização de conveniência — não trava o fluxo se falhar */ });

    document.getElementById('inKm').value = '';
    document.getElementById('inLitros').value = '';
    document.getElementById('inValor').value = '';
    document.getElementById('inPosto').value = '';
    document.getElementById('inObs').value = '';
    document.getElementById('abVeiculoKmHint').textContent = '';
    resetToggles();
    updatePrecoHint();
    msg.textContent = 'Abastecimento adicionado.';
    msg.className = 'msg ok';
  }catch(e){
    msg.textContent = 'Erro ao salvar: ' + e.message;
    msg.className = 'msg err';
  }
  btn.disabled = false;
});

async function excluir(id){
  if(!colRef) return;
  try{ await colRef.doc(id).delete(); }catch(e){ alert('Erro ao excluir: ' + e.message); }
}

function render(){
  let totalKmRodado = 0;
  let totalLitrosComDelta = 0;
  let totalGasto = 0;

  entries.forEach(e => totalGasto += (e.valorReais || 0));

  const withConsumo = entries.map((e, i) => {
    if(i === 0) return {...e, consumo: null};
    const anterior = entries[i-1];
    if(anterior.veiculoId !== e.veiculoId){
      // Trocou de veículo — não dá pra comparar km de carros diferentes.
      return {...e, consumo: null};
    }
    const deltaKm = e.kmAtual - anterior.kmAtual;
    const consumo = deltaKm > 0 ? deltaKm / e.litros : null;
    if(consumo !== null){
      totalKmRodado += deltaKm;
      totalLitrosComDelta += e.litros;
    }
    return {...e, consumo};
  });

  const mediaGeral = totalLitrosComDelta > 0 ? totalKmRodado / totalLitrosComDelta : null;
  const custoPorKm = totalKmRodado > 0 ? totalGasto / totalKmRodado : null;
  const totalLitrosGeral = entries.reduce((s,e) => s + (e.litros||0), 0);
  const precoMedioLitro = totalLitrosGeral > 0 ? totalGasto / totalLitrosGeral : null;
  // (mediaGeral/custoPorKm/precoMedioLitro calculados mas não exibidos mais aqui —
  // o motorista não precisa ver esses números, só o histórico dele.)

  const list = document.getElementById('historyList');
  if(withConsumo.length === 0){
    list.innerHTML = '<div class="empty">Nenhum abastecimento registrado ainda.</div>';
    return;
  }
  const reversed = [...withConsumo].reverse();
  list.innerHTML = reversed.map(e => {
    const consomoTxt = e.consumo !== null ? fmtNum(e.consumo,1) + ' km/l' : (e.consumo === null ? '—' : '');
    const veiculo = veiculos.find(v => v.id === e.veiculoId);
    const tiposLabel = {gasolina_comum:'Gasolina Comum', gasolina_aditivada:'Gasolina Aditivada', etanol:'Etanol', diesel_s10:'Diesel S10', diesel_comum:'Diesel Comum', gnv:'GNV'};
    let tags = '';
    if(veiculo) tags += '<span class="tag posto">' + veiculo.placa + '</span>';
    if(e.tipoCombustivel) tags += '<span class="tag aditivada">' + (tiposLabel[e.tipoCombustivel] || e.tipoCombustivel) + '</span>';
    if(e.emViagem) tags += '<span class="tag viagem">Viagem</span>';
    return `<div class="history-item">
      <div class="hi-left">
        <div class="km">${fmtNum(e.kmAtual,0)} km</div>
        <div class="date">${fmtDate(e.data)} • ${fmtNum(e.litros,2)} L${e.posto ? ' • ' + e.posto : ''}</div>
        <div>${tags}</div>
      </div>
      <div style="display:flex;align-items:center;">
        <div class="hi-right">
          <div class="cons">${consomoTxt}</div>
          <div class="rs">${fmtBRL(e.valorReais)}</div>
        </div>
      </div>
    </div>`;
  }).join('');
}

function renderInsights(withConsumo){
  const comConsumo = withConsumo.filter(e => e.consumo !== null && isFinite(e.consumo) && e.consumo > 0);

  // Sparkline
  const sparkLine = document.getElementById('sparklineLine');
  const sparkFill = document.getElementById('sparklineFill');
  const sparkEmpty = document.getElementById('sparkEmpty');
  if(comConsumo.length >= 2){
    sparkEmpty.style.display = 'none';
    const vals = comConsumo.map(e => e.consumo);
    const min = Math.min(...vals), max = Math.max(...vals);
    const range = (max - min) || 1;
    const W = 300, H = 90, pad = 8;
    const pts = vals.map((v,i) => {
      const x = (i/(vals.length-1)) * (W - pad*2) + pad;
      const y = H - pad - ((v - min)/range) * (H - pad*2);
      return [x,y];
    });
    sparkLine.setAttribute('points', pts.map(p => p.join(',')).join(' '));
    sparkFill.setAttribute('points', pts.map(p => p.join(',')).join(' ') + ` ${W-pad},${H} ${pad},${H}`);
  } else {
    sparkEmpty.style.display = 'inline';
    sparkLine.setAttribute('points','');
    sparkFill.setAttribute('points','');
  }

  const insights = [];

  // Recordes
  if(comConsumo.length >= 1){
    const melhor = comConsumo.reduce((a,b) => b.consumo > a.consumo ? b : a);
    const pior = comConsumo.reduce((a,b) => b.consumo < a.consumo ? b : a);
    document.getElementById('recMelhorValor').textContent = fmtNum(melhor.consumo,1) + ' km/l';
    document.getElementById('recMelhorData').textContent = fmtDate(melhor.data) + ' • ' + fmtNum(melhor.kmAtual,0) + ' km';
    document.getElementById('recPiorValor').textContent = fmtNum(pior.consumo,1) + ' km/l';
    document.getElementById('recPiorData').textContent = fmtDate(pior.data) + ' • ' + fmtNum(pior.kmAtual,0) + ' km';
  }

  // Por tipo de combustível (agora são vários: gasolina comum/aditivada, etanol, diesel, gnv...)
  const tiposLabel = {gasolina_comum:'Gasolina Comum', gasolina_aditivada:'Gasolina Aditivada', etanol:'Etanol', diesel_s10:'Diesel S10', diesel_comum:'Diesel Comum', gnv:'GNV'};
  const porTipo = {};
  comConsumo.forEach(e => {
    const t = e.tipoCombustivel || 'outro';
    if(!porTipo[t]) porTipo[t] = [];
    porTipo[t].push(e);
  });
  const tiposComDados = Object.keys(porTipo).filter(t => porTipo[t].length > 0);
  const elTipo = document.getElementById('compTipoBars');
  if(tiposComDados.length >= 2){
    const medias = tiposComDados.map(t => ({
      tipo: t,
      media: porTipo[t].reduce((s,e)=>s+e.consumo,0) / porTipo[t].length,
      qtd: porTipo[t].length
    })).sort((a,b) => b.media - a.media);
    const maxV = medias[0].media;
    elTipo.innerHTML = medias.map(m => barraComparativa(tiposLabel[m.tipo] || m.tipo, m.media, maxV, m.qtd)).join('');
    const melhorTipo = medias[0];
    const piorTipo = medias[medias.length-1];
    const diffPct = ((melhorTipo.media - piorTipo.media) / piorTipo.media) * 100;
    if(diffPct >= 2){
      insights.push(`<b>${tiposLabel[melhorTipo.tipo] || melhorTipo.tipo}</b> rende ${fmtNum(diffPct,1)}% mais km/l que ${tiposLabel[piorTipo.tipo] || piorTipo.tipo} nos seus registros.`);
    }
  } else if(tiposComDados.length === 1){
    const unico = tiposComDados[0];
    elTipo.innerHTML = barraComparativa(tiposLabel[unico] || unico, porTipo[unico].reduce((s,e)=>s+e.consumo,0)/porTipo[unico].length, 1, porTipo[unico].length);
  } else {
    elTipo.innerHTML = '<div class="empty">Registre abastecimentos para comparar tipos de combustível.</div>';
  }

  // Cidade vs Viagem
  const urbano = comConsumo.filter(e => !e.emViagem);
  const viagem = comConsumo.filter(e => e.emViagem);
  const mediaUrbano = urbano.length ? urbano.reduce((s,e)=>s+e.consumo,0)/urbano.length : null;
  const mediaViagem = viagem.length ? viagem.reduce((s,e)=>s+e.consumo,0)/viagem.length : null;
  const elViagem = document.getElementById('compViagemBars');
  if(mediaUrbano !== null && mediaViagem !== null){
    const maxV = Math.max(mediaUrbano, mediaViagem);
    elViagem.innerHTML = barraComparativa('Cidade', mediaUrbano, maxV, urbano.length) +
                          barraComparativa('Viagem', mediaViagem, maxV, viagem.length);
    const diffPct = ((mediaViagem - mediaUrbano) / mediaUrbano) * 100;
    if(Math.abs(diffPct) >= 2){
      insights.push(`Em viagem seu consumo é <b>${diffPct>0?'+':''}${fmtNum(diffPct,1)}%</b> comparado ao uso na cidade.`);
    }
  } else {
    elViagem.innerHTML = '<div class="empty">Registre abastecimentos em viagem para comparar.</div>';
  }

  // Postos (agora é texto livre — agrupa pelos nomes mais usados)
  const comPosto = entries.filter(e => e.posto);
  const contagemPostos = {};
  comPosto.forEach(e => {
    const nome = e.posto.trim();
    contagemPostos[nome] = (contagemPostos[nome] || 0) + 1;
  });
  const rankingPostos = Object.keys(contagemPostos)
    .map(nome => ({nome, qtd: contagemPostos[nome]}))
    .sort((a,b) => b.qtd - a.qtd)
    .slice(0, 5);
  const elPosto = document.getElementById('compPostoBars');
  if(rankingPostos.length > 0){
    const totalComPosto = comPosto.length;
    const maxQtd = rankingPostos[0].qtd;
    elPosto.innerHTML = rankingPostos.map(p => {
      const pct = (p.qtd/maxQtd)*100;
      return `<div class="comp-bar-item">
        <div class="comp-bar-head"><span class="nome">${p.nome}</span><span class="num">${p.qtd}x</span></div>
        <div class="comp-bar-track"><div class="comp-bar-fill" style="width:${pct}%"></div></div>
        <div class="comp-bar-note">${fmtNum((p.qtd/totalComPosto)*100,0)}% dos abastecimentos</div>
      </div>`;
    }).join('');
    if(rankingPostos.length >= 1){
      insights.push(`Seu posto mais usado é <b>${rankingPostos[0].nome}</b> (${rankingPostos[0].qtd} abastecimento${rankingPostos[0].qtd !== 1 ? 's' : ''}).`);
    }
  } else {
    elPosto.innerHTML = '<div class="empty">Sem dados suficientes.</div>';
  }

  // Preço do combustível
  const comPreco = entries.filter(e => e.litros > 0 && e.valorReais > 0 && e.data && e.data.toDate)
    .map(e => ({...e, preco: e.valorReais/e.litros, dataObj: e.data.toDate()}))
    .sort((a,b) => a.dataObj - b.dataObj);
  if(comPreco.length >= 2){
    const primeiro = comPreco[0];
    const ultimo = comPreco[comPreco.length-1];
    document.getElementById('precoPrimeiro').textContent = fmtBRL(primeiro.preco);
    document.getElementById('precoUltimo').textContent = fmtBRL(ultimo.preco);
    const diffPct = ((ultimo.preco - primeiro.preco)/primeiro.preco)*100;
    const tendHint = document.getElementById('precoTendenciaHint');
    if(Math.abs(diffPct) < 1){
      tendHint.textContent = 'O preço do litro está estável desde o seu primeiro registro.';
    } else if(diffPct > 0){
      tendHint.textContent = `O preço do litro subiu ${fmtNum(diffPct,1)}% desde o seu primeiro registro.`;
      insights.push(`O combustível <b>subiu ${fmtNum(diffPct,1)}%</b> desde seu primeiro abastecimento registrado.`);
    } else {
      tendHint.textContent = `O preço do litro caiu ${fmtNum(Math.abs(diffPct),1)}% desde o seu primeiro registro.`;
      insights.push(`O combustível <b>caiu ${fmtNum(Math.abs(diffPct),1)}%</b> desde seu primeiro abastecimento registrado.`);
    }
  } else {
    document.getElementById('precoPrimeiro').textContent = '--';
    document.getElementById('precoUltimo').textContent = '--';
    document.getElementById('precoTendenciaHint').textContent = 'Registre mais abastecimentos para ver a tendência de preço.';
  }

  if(comConsumo.length >= 1){
    const melhor = comConsumo.reduce((a,b) => b.consumo > a.consumo ? b : a);
    insights.unshift(`Seu melhor consumo até agora foi <b>${fmtNum(melhor.consumo,1)} km/l</b>, em ${fmtDate(melhor.data)}.`);
  }

  const insightList = document.getElementById('insightList');
  if(insights.length){
    insightList.innerHTML = insights.map(t => `<li>${t}</li>`).join('');
  } else {
    insightList.innerHTML = '<li class="empty" style="padding:0;">Registre mais abastecimentos para gerar insights.</li>';
  }
}

function barraComparativa(nome, valor, maxV, qtd){
  const pct = maxV > 0 ? (valor/maxV)*100 : 0;
  return `<div class="comp-bar-item">
    <div class="comp-bar-head"><span class="nome">${nome}</span><span class="num">${fmtNum(valor,1)} km/l</span></div>
    <div class="comp-bar-track"><div class="comp-bar-fill" style="width:${pct}%"></div></div>
    <div class="comp-bar-note">${qtd} abastecimento${qtd !== 1 ? 's' : ''}</div>
  </div>`;
}
function barraPosto(nome, pct, lista){
  const gasto = lista.reduce((s,e) => s + (e.valorReais||0), 0);
  return `<div class="comp-bar-item">
    <div class="comp-bar-head"><span class="nome">${nome}</span><span class="num">${fmtNum(pct,0)}%</span></div>
    <div class="comp-bar-track"><div class="comp-bar-fill" style="width:${pct}%"></div></div>
    <div class="comp-bar-note">${lista.length} abastecimento${lista.length !== 1 ? 's' : ''} • ${fmtBRL(gasto)}</div>
  </div>`;
}

function renderPrevisao(){
  const comData = entries
    .filter(e => e.data && e.data.toDate)
    .map(e => ({...e, dataObj: e.data.toDate()}))
    .sort((a,b) => a.dataObj - b.dataObj);

  const elDias = document.getElementById('statDiasMedio');
  const elKm = document.getElementById('statKmMedio');
  const elPredData = document.getElementById('predData');
  const elPredKm = document.getElementById('predKm');
  const elHint = document.getElementById('predHint');
  const listEl = document.getElementById('intervaloList');

  if(comData.length < 2){
    elDias.textContent = '-- dias';
    elKm.textContent = '-- km';
    elPredData.textContent = '--';
    elPredKm.textContent = '--';
    elHint.textContent = 'Registre pelo menos 2 abastecimentos com data para calcular intervalos.';
    listEl.innerHTML = '<div class="empty">Sem dados suficientes ainda.</div>';
    return;
  }

  const intervalos = [];
  for(let i = 1; i < comData.length; i++){
    const anterior = comData[i-1];
    const atual = comData[i];
    const diffMs = atual.dataObj - anterior.dataObj;
    const dias = diffMs / (1000*60*60*24);
    const km = atual.kmAtual - anterior.kmAtual;
    intervalos.push({dias, km, dataAtual: atual.dataObj, dataAnterior: anterior.dataObj});
  }

  const mediaDias = intervalos.reduce((s,i) => s + i.dias, 0) / intervalos.length;
  const mediaKm = intervalos.reduce((s,i) => s + i.km, 0) / intervalos.length;

  elDias.textContent = fmtNum(mediaDias,1) + ' dias';
  elKm.textContent = fmtNum(mediaKm,0) + ' km';

  const ultimo = comData[comData.length - 1];
  const dataPrevista = new Date(ultimo.dataObj.getTime() + mediaDias*24*60*60*1000);
  const kmPrevisto = ultimo.kmAtual + mediaKm;

  elPredData.textContent = dataPrevista.toLocaleDateString('pt-BR', {day:'2-digit', month:'2-digit', year:'2-digit'});
  elPredKm.textContent = fmtNum(kmPrevisto,0) + ' km';

  elHint.textContent = intervalos.length < 3
    ? 'Registre pelo menos 3 abastecimentos para uma previsão mais confiável.'
    : 'Estimativa baseada na média dos últimos ' + intervalos.length + ' intervalos.';

  const reversedIntervalos = [...intervalos].reverse();
  listEl.innerHTML = reversedIntervalos.map(i => {
    const dataTxt = i.dataAtual.toLocaleDateString('pt-BR', {day:'2-digit', month:'2-digit'});
    return `<div class="intervalo-item">
      <div>
        <div>${dataTxt}</div>
        <div class="periodo">${fmtNum(i.dias,1)} dias depois do anterior</div>
      </div>
      <div class="valores">${fmtNum(i.km,0)} km</div>
    </div>`;
  }).join('');
}

if('serviceWorker' in navigator){
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('/sw.js').catch(err => {
      console.warn('Service worker não registrado:', err);
    });
  });
}
</script>
</body>
</html>
